# SimVision Command Script (Mon Jun 03 01:04:01 PM PDT 2019)
#
# Version 19.03.s004
#
# You can restore this configuration with:
#
#     simvision -input simvision.svcf
#


#
# Preferences
#
preferences set display-signal-value-fullprecision 1
preferences set txe-locate-add-fibers 1
preferences set signal-type-colors {assertion #FF0000 output #FFA500 group #0099FF inout #00FFFF input #FFFF00 fiber #00EEEE errorsignal #FF0000 unknown #FFFFFF overlay #0099FF internal #00FF00 reference #FFFFFF}
preferences set txe-navigate-search-locate 0
preferences set txe-view-hold 0
preferences set plugin-enable-svdatabrowser-new 1
preferences set cursorctl-dont-show-sync-warning 1
preferences set verilog-colors {Su #ff0099 0 {} 1 {} HiZ #ff9900 We #00ffff Pu #9900ff Sm #00ff99 X #ff0000 StrX #ff0000 other #ffff00 Z #ff9900 Me #0000ff La #ff00ff St {}}
preferences set toolbar-sendToIndago-WaveWindow {
  usual
  position -pos 1
}
preferences set txe-navigate-waveform-locate 1
preferences set txe-view-hidden 0
preferences set waveform-print-paper {Tabloid (11 x 17)}
preferences set toolbar-Standard-Console {
  usual
  position -pos 1
}
preferences set txe-search-show-linenumbers 1
preferences set toolbar-Search-Console {
  usual
  position -pos 2
}
preferences set plugin-enable-groupscope 0
preferences set key-bindings {Edit>Undo Ctrl+z PageUp PageUp View>Zoom>Next {Alt+Right arrow} View>Zoom>In Alt+i PageDown PageDown Edit>Copy Ctrl+c ScrollDown {Down arrow} Edit>Create>Group Ctrl+g View>Zoom>FullY_widget y Simulation>NextInScope F7 Edit>Select>All Ctrl+a Format>Radix>Decimal Ctrl+Shift+D Edit>Ungroup Ctrl+Shift+G TopOfPage Home Edit>Create>Condition Ctrl+e {command -console SimVision {%w sidebar access designbrowser selectall}} Alt+a ScrollLeft {Left arrow} Edit>SelectAllText Alt+a Edit>TextSearchConsole Alt+s View>Zoom>FullX_widget = Windows>SendTo>Waveform Ctrl+w Simulation>Return Shift+F5 View>CallstackDown {Ctrl+Down arrow} Select>All Ctrl+a Edit>Delete Del Format>Radix>Octal Ctrl+Shift+O Edit>Cut Ctrl+x Simulation>Run F2 Edit>Create>Marker Ctrl+m View>Center Alt+c View>CallstackInWindow Ctrl+k Edit>SelectAll Ctrl+a File>OpenDatabase Ctrl+o Edit>Redo Ctrl+y Format>Radix>Binary Ctrl+Shift+B View>ExpandSequenceTime>AtCursor Alt+x ScrollUp {Up arrow} File>CloseWindow Ctrl+Shift+w ScrollRight {Right arrow} View>Zoom>FullX Alt+= Edit>Create>Bus Ctrl+b Explore>NextEdge Ctrl+\] View>Zoom>Cursor-Baseline Alt+z View>Zoom>OutX Alt+o Edit>GoToLine Ctrl+g View>Zoom>Fit Alt+= View>Zoom>OutX_widget o View>CallstackUp {Ctrl+Up arrow} View>Bookmarks>Add Ctrl+b View>ShowValues Ctrl+s Simulation>Next F6 Edit>Search Ctrl+f Format>Radix>Hexadecimal Ctrl+Shift+H Edit>Create>MarkerAtCursor Ctrl+Shift+M View>Zoom>InX Alt+i View>Zoom>Out Alt+o Edit>TextSearch Ctrl+f View>Zoom>Previous {Alt+Left arrow} Edit>Paste Ctrl+v Format>Signed Ctrl+Shift+S View>CollapseSequenceTime>AtCursor Alt+s View>Zoom>InX_widget i Format>Radix>ASCII Ctrl+Shift+A Simulation>Step F5 Explore>PreviousEdge {Ctrl+[} BottomOfPage End}
preferences set plugin-enable-interleaveandcompare 0
preferences set plugin-enable-waveformfrequencyplot 0
preferences set waveform-print-colors {Color on white}
preferences set txe-navigate-waveform-next-child 1
preferences set signal-trace-sidebar-mode full
preferences set vhdl-colors {H #00ffff L #00ffff 0 {} X #ff0000 - {} 1 {} U #9900ff Z #ff9900 W #ff0000}
preferences set txe-locate-scroll-x 1
preferences set txe-locate-scroll-y 1
preferences set txe-locate-pop-waveform 1
preferences set analog-sampling 1
#
# Groups
#
catch {group new -name {Group 1} -overlay 1}
catch {group new -name {Group 2} -overlay 1}
group using {Group 1}
group set -overlay 1
group set -comment {}
group clear 0 end

group insert \
    [subst  {[format {rxBB_sim.ISTIMULUS.Iout_int}]} ] \
    [subst  {[format {rxBB_sim.ISTIMULUS.iDiff}]} ]
group using {Group 2}
group set -overlay 1
group set -comment {}
group clear 0 end

group insert \
    [subst  {[format {rxBB_sim.ISTIMULUS.Qout_int}]} ] \
    [subst  {[format {rxBB_sim.ISTIMULUS.qDiff}]} ]

#
# Mnemonic Maps
#
mmap new  -reuse -name {Boolean as Logic} -radix %b -contents {{%c=FALSE -edgepriority 1 -shape low}
{%c=TRUE -edgepriority 1 -shape high}}
mmap new  -reuse -name {Example Map} -radix %x -contents {{%b=11???? -bgcolor orange -label REG:%x -linecolor yellow -shape bus}
{%x=1F -bgcolor red -label ERROR -linecolor white -shape EVENT}
{%x=2C -bgcolor red -label ERROR -linecolor white -shape EVENT}
{%x=* -label %x -linecolor gray -shape bus}}

#
# Design Browser windows
#
if {[catch {window new WatchList -name "Design Browser 1" -geometry 730x500+261+33}] != ""} {
    window geometry "Design Browser 1" 730x500+261+33
}
window target "Design Browser 1" on
browser using {Design Browser 1}
browser set -scope [subst  {[format {rxBB_sim.IrxBB}]} ]
browser set \
    -signalsort name
browser yview see [subst  {[format {rxBB_sim.IrxBB}]} ]
browser timecontrol set -lock 0

#
# Waveform windows
#
if {[catch {window new WaveWindow -name "Waveform 1" -geometry 1294x729+6+103}] != ""} {
    window geometry "Waveform 1" 1294x729+6+103
}
window target "Waveform 1" on
waveform using {Waveform 1}
waveform sidebar visibility partial
waveform set \
    -primarycursor TimeA \
    -signalnames name \
    -signalwidth 175 \
    -units ps \
    -valuewidth 75
waveform baseline set -time 429,929,032ps


set groupId0 [waveform add -groups {{Group 1}}]
set gpGlist0 [waveform hierarchy contents $groupId0]
set gpID0 [lindex $gpGlist0 0]
foreach {name attrs} [subst  {
    {[format {rxBB_sim.ISTIMULUS.Iout_int}]} {-trace analogLinear}
    {[format {rxBB_sim.ISTIMULUS.iDiff}]} {-trace analogLinear}
}] childcmds {
    {}
    {}
} {
    set expected [ join [waveform signals -format path $gpID0] ]
    if {[string equal $name $expected] || $name == "cdivider"} {
        if {$attrs != ""} {
            eval waveform format $gpID0 $attrs
        }
        if { $childcmds != ""} {
            eval $childcmds
        }
    }
    set gpGlist0 [lrange $gpGlist0 1 end]
    set gpID0 [lindex $gpGlist0 0]
}

waveform axis range $groupId0 -for default -min -0.10000000000000001 -max 0.10000000000000001 -scale linear
waveform axis activate $groupId0 -for default
set id [waveform add -signals [subst  {
	{[format {signed(rxBB_sim.IrxBB.outi)}]}
	} ]]
waveform format $id -trace analogSampleAndHold
waveform axis range $id -for default -min -16 -max 16 -scale linear

set groupId0 [waveform add -groups {{Group 2}}]
set gpGlist0 [waveform hierarchy contents $groupId0]
set gpID0 [lindex $gpGlist0 0]
foreach {name attrs} [subst  {
    {[format {rxBB_sim.ISTIMULUS.Qout_int}]} {-trace analogLinear}
    {[format {rxBB_sim.ISTIMULUS.qDiff}]} {-trace analogLinear}
}] childcmds {
    {}
    {}
} {
    set expected [ join [waveform signals -format path $gpID0] ]
    if {[string equal $name $expected] || $name == "cdivider"} {
        if {$attrs != ""} {
            eval waveform format $gpID0 $attrs
        }
        if { $childcmds != ""} {
            eval $childcmds
        }
    }
    set gpGlist0 [lrange $gpGlist0 1 end]
    set gpID0 [lindex $gpGlist0 0]
}

waveform axis range $groupId0 -for default -min -0.099802672842828621 -max 0.099802672842828732 -scale linear
waveform axis activate $groupId0 -for default
set id [waveform add -signals [subst  {
	{[format {signed(rxBB_sim.IrxBB.outq)}]}
	} ]]
waveform format $id -trace analogSampleAndHold
waveform axis range $id -for default -min -16 -max 16 -scale linear
set id [waveform add -signals [subst  {
	{[format {rxBB_sim.IrxBB.outClkI}]}
	} ]]
set id [waveform add -signals [subst  {
	{[format {rxBB_sim.IrxBB.outClkQ}]}
	} ]]
set id [waveform add -signals [subst  {
	{[format {rxBB_sim.IrxBB.adcInp[1]}]}
	} ]]
waveform format $id -trace analogSampleAndHold
waveform axis range $id -for default -min 0.61230794598335536 -max 0.88770213761147532 -scale linear
set id [waveform add -signals [subst  {
	{[format {rxBB_sim.IrxBB.adcInm[1]}]}
	} ]]
waveform format $id -trace analogSampleAndHold
waveform axis range $id -for default -min 0.61229786238852468 -max 0.88769205401664464 -scale linear
set id [waveform add -signals [subst  {
	{[format {rxBB_sim.IrxBB.adcInp[0]}]}
	} ]]
waveform format $id -trace analogSampleAndHold
waveform axis range $id -for default -min 0.61225200177604067 -max 0.8877479987887813 -scale linear
set id [waveform add -signals [subst  {
	{[format {rxBB_sim.IrxBB.adcInm[0]}]}
	} ]]
waveform format $id -trace analogSampleAndHold
waveform axis range $id -for default -min 0.6122520012112187 -max 0.88774799822395933 -scale linear
set id [waveform add -signals [subst  {
	{[format {rxBB_sim.IrxBB.clkp}]}
	} ]]
set id [waveform add -signals [subst  {
	{[format {rxBB_sim.IrxBB.fClkp}]}
	} ]]
set id [waveform add -signals [subst  {
	{[format {rxBB_sim.IrxBB.en}]}
	} ]]
set id [waveform add -signals [subst  {
	{[format {rxBB_sim.IrxBB.adcRefEn}]}
	} ]]
set id [waveform add -signals [subst  {
	{[format {rxBB_sim.IrxBB.IBBA.vCM}]}
	} ]]
waveform format $id -trace analogLinear
waveform axis range $id -for default -min 0.67500000000000004 -max 0.82500000000000007 -scale linear
set id [waveform add -signals [subst  {
	{[format {rxBB_sim.IrxBB.IBBA.iOutDiff}]}
	} ]]
waveform format $id -trace analogLinear
waveform axis range $id -for default -min -0.27549599644791867 -max 0.27549599757756266 -scale linear
set id [waveform add -signals [subst  {
	{[format {rxBB_sim.IrxBB.IBBA.iInDiff}]}
	} ]]
waveform format $id -trace analogLinear
waveform axis range $id -for default -min -0.10000000000000009 -max 0.10000000000000009 -scale linear
set id [waveform add -signals [subst  {
	{[format {rxBB_sim.IrxBB.dcoci[7:0]}]}
	} ]]
set id [waveform add -signals [subst  {
	{[format {rxBB_sim.IrxBB.dcocq[7:0]}]}
	} ]]
set id [waveform add -signals [subst  {
	{[format {rxBB_sim.IrxBB.net027}]}
	} ]]
waveform format $id -trace analogLinear
waveform axis range $id -for default -min -1 -max 1 -scale linear
set id [waveform add -signals [subst  {
	{[format {rxBB_sim.IrxBB.net028}]}
	} ]]
waveform format $id -trace analogLinear
waveform axis range $id -for default -min -1 -max 1 -scale linear
set id [waveform add -signals [subst  {
	{[format {rxBB_sim.IrxBB.net029}]}
	} ]]
waveform format $id -trace analogLinear
waveform axis range $id -for default -min -1 -max 1 -scale linear
set id [waveform add -signals [subst  {
	{[format {rxBB_sim.IrxBB.net030}]}
	} ]]
waveform format $id -trace analogLinear
waveform axis range $id -for default -min -1 -max 1 -scale linear

waveform xview limits 439109774ps 457471258ps

#
# Waveform Window Links
#

