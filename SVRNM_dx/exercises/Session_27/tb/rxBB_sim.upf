set_design_top rxBB_sim -testbench

# Define Power Supply Network

# Create Supply Nets
create_supply_net vddrx 
create_supply_net vss

create_supply_set SS_1p4   -function {power  vddrx} \
                           -function {ground vss}

# Create Power Domains.
create_power_domain  PD_vddrx -supply {primary SS_1p4} \
                              -elements { IrxBB/IADC/ILOGIC }

# HDL real to UPF voltage conversion for vddrx
create_hdl2upf_vct VCTwr2upf_vddrx -hdl_type {sv EEnet.V} \
   -table { {===`wrealXState -100.0} {===`wrealZState -100.0} }


# HDL real to UPF state conversion for vddrx
create_hdl2upf_vct VCTwr2sta_vddrx -hdl_type {sv EEnet.V} \
   -table { {>=1.1 FULL_ON} {>0.9 PARTIAL_ON} {<=0.9 OFF} {>1.8 OFF} {==-100.0 UNDETERMINED} }

# HDL real to UPF voltage conversion for vss
create_hdl2upf_vct VCTwr2upf_vss -hdl_type {sv EEnet.V} \
   -table { {===`wrealXState -10.0} {===`wrealZState -10.0} }


# HDL real to UPF state conversion for vss
create_hdl2upf_vct VCTwr2sta_vss -hdl_type {sv EEnet.V} \
   -table { {<=-0.1 OFF} {>=0.1 OFF} {>-0.1 FULL_ON} {==-10.0 UNDETERMINED} }


connect_supply_net vddrx  -ports { ILDO/VOUT IrxBB/IADC/ILOGIC/vdd } -vct VCTwr2upf_vddrx
connect_supply_net vddrx  -ports { ILDO/VOUT IrxBB/IADC/ILOGIC/vdd } -vct VCTwr2sta_vddrx

connect_supply_net vss     -ports { ISTIMULUS/vss  IrxBB/vss ILDO/VSS } -vct VCTwr2upf_vss
connect_supply_net vss     -ports { ISTIMULUS/vss  IrxBB/vss ILDO/VSS } -vct VCTwr2sta_vss

