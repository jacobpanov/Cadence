#
# Groups
#
catch {group new -name {Group 1} -overlay 1}
group using {Group 1}
group set -overlay 1
group set -comment {}
group clear 0 end

group insert \
    waves::myEEcheck.R1 \
    waves::myEEcheck.R2

#
# Mnemonic Maps
#
mmap new  -reuse -name {Boolean as Logic} -radix %b -contents {{%c=FALSE -edgepriority 1 -shape low}
{%c=TRUE -edgepriority 1 -shape high}}
mmap new  -reuse -name {Example Map} -radix %x -contents {{%b=11???? -bgcolor orange -label REG:%x -linecolor yellow -shape bus}
{%x=1F -bgcolor red -label ERROR -linecolor white -shape EVENT}
{%x=2C -bgcolor red -label ERROR -linecolor white -shape EVENT}
{%x=* -label %x -linecolor gray -shape bus}}

#
# Design Browser windows
#
if {[catch {window new WatchList -name "Design Browser 1" -geometry 730x500+261+33}] != ""} {
    window geometry "Design Browser 1" 730x500+261+33
}
window target "Design Browser 1" on
browser using {Design Browser 1}
browser set -scope  simulator::myEEcheck 
browser set \
    -signalsort name
browser yview see  simulator::myEEcheck 
browser timecontrol set -lock 0

#
# Waveform windows
#
if {[catch {window new WaveWindow -name "Waveform 1" -geometry 1255x846+651+27}] != ""} {
    window geometry "Waveform 1" 1255x846+651+27
}
window target "Waveform 1" on
waveform using {Waveform 1}
waveform sidebar visibility partial
waveform set \
    -primarycursor TimeA \
    -signalnames path \
    -signalwidth 147 \
    -units ps \
    -valuewidth 81
waveform baseline set -time 0

set id [waveform add -signals  {
	waves::myEEcheck.V1
	} ]
waveform format $id -trace analogSampleAndHold
waveform axis range $id -for default -min 1.3877787807814457e-16 -max 3 -scale linear

set groupId0 [waveform add -groups {{Group 1}}]
set gpGlist0 [waveform hierarchy contents $groupId0]
set gpID0 [lindex $gpGlist0 0]
foreach {name attrs}  {
    waves::myEEcheck.R1 {-height 56 -trace analogSampleAndHold}
    waves::myEEcheck.R2 {-height 56 -trace analogSampleAndHold}
} childcmds {
    {}
    {}
} {
    set expected [ join [waveform signals -format fullpath $gpID0] ]
    if {[string equal $name $expected] || $name == "cdivider"} {
        if {$attrs != ""} {
            eval waveform format $gpID0 $attrs
        }
        if { $childcmds != ""} {
            eval $childcmds
        }
    }
    set gpGlist0 [lrange $gpGlist0 1 end]
    set gpID0 [lindex $gpGlist0 0]
}

waveform axis range $groupId0 -for default -min 0 -max 4000 -scale linear
waveform axis activate $groupId0 -for default
set id [waveform add -signals  {
	waves::myEEcheck.I3
	} ]
waveform format $id -trace analogSampleAndHold
waveform axis range $id -for default -min -0.002 -max 0.002 -scale linear
set id [waveform add -signals  {
	waves::myEEcheck.A
	} ]
waveform hierarchy expand $id
set id2 [lindex [waveform hierarchy content $id] 0]
waveform format $id2 -height 128 -trace analogSampleAndHold
set id2 [lindex [waveform hierarchy content $id] 1]
waveform format $id2 -trace analogSampleAndHold
set id2 [lindex [waveform hierarchy content $id] 2]
waveform format $id2 -height 84 -trace analogSampleAndHold
set id [waveform add -signals  {
	waves::myEEcheck.Vmeas
	} ]
waveform format $id -trace analogSampleAndHold
waveform axis range $id -for default -min -0.5 -max 3 -scale linear
set id [waveform add -signals  {
	waves::myEEcheck.Imeas
	} ]
waveform format $id -trace analogSampleAndHold
waveform axis range $id -for default -min -0.0030000000000000001 -max 0.001 -scale linear
set id [waveform add -signals  {
	simulator::myEEcheck.Imeas1
	} ]
waveform format $id -trace analogSampleAndHold
waveform axis range $id -for default -min -1000 -max 6000 -scale linear
set id [waveform add -signals  {
	simulator::myEEcheck.Imeas2
	} ]
waveform format $id -trace analogSampleAndHold
waveform axis range $id -for default -min -6000 -max 1000 -scale linear
set id [waveform add -signals  {
	simulator::myEEcheck.B
	} ]
waveform hierarchy expand $id
set id2 [lindex [waveform hierarchy content $id] 0]
waveform format $id2 -trace analogSampleAndHold
set id2 [lindex [waveform hierarchy content $id] 1]
waveform format $id2 -trace analogSampleAndHold
set id2 [lindex [waveform hierarchy content $id] 2]
waveform format $id2 -trace analogSampleAndHold

waveform xview limits 0 890000ps

#
# Waveform Window Links
#

#
# Source Browser windows
#
if {[catch {window new SrcBrowser -name "Source Browser 1" -geometry 700x525+925+192}] != ""} {
    window geometry "Source Browser 1" 700x525+925+192
}
window target "Source Browser 1" on
srcbrowser using {Source Browser 1}
srcbrowser set \
    -primarycursor TimeA \
    -units ps \
    -radix default \
    -showstrength 0 \
    -showcallstack 0 \
    -displayvalues 1

srcbrowser show -scope myEEcheck -file /home/jpanov/Cadence/SVRNM_dx/exercises/Session_07/tb/myEEcheck.sv -line 49

srcbrowser sidebar visibility partial

#
# Console windows
#
console set -windowname Console
window geometry Console 730x250+261+564

