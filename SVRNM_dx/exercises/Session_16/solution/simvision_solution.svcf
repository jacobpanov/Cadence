    [subst  {[format {buck_tb.Ebuck.Dio.Idio}]} ]

#
# Mnemonic Maps
#
mmap new  -reuse -name {Boolean as Logic} -radix %b -contents {{%c=FALSE -edgepriority 1 -shape low}
{%c=TRUE -edgepriority 1 -shape high}}
mmap new  -reuse -name {Example Map} -radix %x -contents {{%b=11???? -bgcolor orange -label REG:%x -linecolor yellow -shape bus}
{%x=1F -bgcolor red -label ERROR -linecolor white -shape EVENT}
{%x=2C -bgcolor red -label ERROR -linecolor white -shape EVENT}
{%x=* -label %x -linecolor gray -shape bus}}

#
# Design Browser windows
#
if {[catch {window new WatchList -name "Design Browser 1" -geometry 730x691+232+26}] != ""} {
    window geometry "Design Browser 1" 730x691+232+26
}
window target "Design Browser 1" on
browser using {Design Browser 1}
browser set -scope [subst  {[format {buck_tb.Ebuck.Dio}]} ]
browser set \
    -signalsort name
browser yview see [subst  {[format {buck_tb.Ebuck.Dio}]} ]
browser timecontrol set -lock 0

#
# Waveform windows
#
if {[catch {window new WaveWindow -name "Waveform 2" -geometry 1473x849+439+130}] != ""} {
    window geometry "Waveform 2" 1473x849+439+130
}
window target "Waveform 2" on
waveform using {Waveform 2}
waveform sidebar visibility partial
waveform set \
    -primarycursor TimeA \
    -signalnames path \
    -signalwidth 205 \
    -units us \
    -valuewidth 156
waveform baseline set -time 8138.887us


set groupId0 [waveform add -groups Output-Voltage]
set gpGlist0 [waveform hierarchy contents $groupId0]
set gpID0 [lindex $gpGlist0 0]
foreach {name attrs} [subst  {
    {[format {buck_tb.EOUT}]} {-height 58 -trace analogLinear}
    {[format {buck_tb.OUT.V}]} {-height 58 -trace analogLinear}
}] childcmds {
    {}
    {}
} {
    set expected [ join [waveform signals -format path $gpID0] ]
    if {[string equal $name $expected] || $name == "cdivider"} {
        if {$attrs != ""} {
            eval waveform format $gpID0 $attrs
        }
        if { $childcmds != ""} {
            eval $childcmds
        }
    }
    set gpGlist0 [lrange $gpGlist0 1 end]
    set gpID0 [lindex $gpGlist0 0]
}

waveform axis range $groupId0 -for default -min -0.00019857081435194462 -max 3.7934845679012574 -scale linear
waveform axis range $groupId0 -for V -min 0 -max 3.7120117816768579 -scale linear
waveform axis activate $groupId0 -for default

set groupId0 [waveform add -groups Inductor-Current]
set gpGlist0 [waveform hierarchy contents $groupId0]
set gpID0 [lindex $gpGlist0 0]
foreach {name attrs} [subst  {
    {[format {buck_tb.Ebuck.Ind.Iana}]} {-height 58 -trace analogLinear}
    {[format {buck_tb.Buck.Ind.Iind}]} {-height 58 -trace analogLinear}
}] childcmds {
    {}
    {}
} {
    set expected [ join [waveform signals -format path $gpID0] ]
    if {[string equal $name $expected] || $name == "cdivider"} {
        if {$attrs != ""} {
            eval waveform format $gpID0 $attrs
        }
        if { $childcmds != ""} {
            eval $childcmds
        }
    }
    set gpGlist0 [lrange $gpGlist0 1 end]
    set gpID0 [lindex $gpGlist0 0]
}

waveform axis range $groupId0 -for default -min -0.0010705768572748797 -max 0.13620627559405307 -scale linear
waveform axis activate $groupId0 -for default

set groupId0 [waveform add -groups Midnode-Voltage]
set gpGlist0 [waveform hierarchy contents $groupId0]
set gpID0 [lindex $gpGlist0 0]
foreach {name attrs} [subst  {
    {[format {buck_tb.Ebuck.M}]} {-height 40 -trace analogLinear}
    {[format {buck_tb.Buck.M.V}]} {-height 40 -trace analogLinear}
}] childcmds {
    {}
    {}
} {
    set expected [ join [waveform signals -format path $gpID0] ]
    if {[string equal $name $expected] || $name == "cdivider"} {
        if {$attrs != ""} {
            eval waveform format $gpID0 $attrs
        }
        if { $childcmds != ""} {
            eval $childcmds
        }
    }
    set gpGlist0 [lrange $gpGlist0 1 end]
    set gpID0 [lindex $gpGlist0 0]
}

waveform axis range $groupId0 -for default -min -0.21358216003822894 -max 16.215683299156431 -scale linear
waveform axis range $groupId0 -for V -min -0.21967047741188384 -max 8.7693652418307941 -scale linear
waveform axis activate $groupId0 -for V

set groupId0 [waveform add -groups Diode-Current]
set gpGlist0 [waveform hierarchy contents $groupId0]
set gpID0 [lindex $gpGlist0 0]
foreach {name attrs} [subst  {
    {[format {buck_tb.Buck.Dio.Idio}]} {-height 34 -trace analogSampleAndHold}
    {[format {buck_tb.Ebuck.Dio.Idio}]} {-height 34 -trace analogSampleAndHold}
}] childcmds {
    {}
    {}
} {
    set expected [ join [waveform signals -format path $gpID0] ]
    if {[string equal $name $expected] || $name == "cdivider"} {
        if {$attrs != ""} {
            eval waveform format $gpID0 $attrs
        }
        if { $childcmds != ""} {
            eval $childcmds
        }
    }
    set gpGlist0 [lrange $gpGlist0 1 end]
    set gpID0 [lindex $gpGlist0 0]
}

waveform axis range $groupId0 -for default -min -0.00016415683299156433 -max 0.1358931014751196 -scale linear
waveform axis activate $groupId0 -for default

set groupId0 [waveform add -groups Switch-Res]
set gpGlist0 [waveform hierarchy contents $groupId0]
set gpID0 [lindex $gpGlist0 0]
foreach {name attrs} [subst  {
    {[format {buck_tb.Buck.Swt.Rdrv}]} {-height 34 -trace analogSampleAndHold}
    {[format {buck_tb.Ebuck.Swt.Rramp}]} {-height 34 -trace analogSampleAndHold}
}] childcmds {
