#
# Groups
#
catch {group new -name {MIddle node} -overlay 1}
catch {group new -name {Inductor current} -overlay 0}
catch {group new -name {Output Voltage} -overlay 0}
catch {group new -name {Group 4} -overlay 1}
catch {group new -name {Group 1} -overlay 1}
catch {group new -name {Group 2} -overlay 1}
catch {group new -name {Group 3} -overlay 1}
catch {group new -name {Group 5} -overlay 1}
catch {group new -name {Switch Resistance} -overlay 1}
catch {group new -name Output-Voltage -overlay 1}
catch {group new -name Inductor-Current -overlay 1}
catch {group new -name Midnode-Voltage -overlay 1}
catch {group new -name Switch-Res -overlay 1}
catch {group new -name Diode-Current -overlay 1}
group using {MIddle node}
group set -overlay 1
group set -comment {}
group clear 0 end

group insert \
    [subst  {[format {buck_tb.Ebuck.M}]} ] \
    [subst  {[format {buck_tb.Buck.M.V}]} ]
group using {Inductor current}
group set -overlay 0
group set -comment {}
group clear 0 end

group insert \
    [subst  {[format {buck_tb.Ebuck.Ind.Iana}]} ] \
    [subst  {[format {buck_tb.Buck.Ind.Iind}]} ] \
    [subst  {[format {buck_tb.Freq}]} ] \
    [subst  {[format {buck_tb.Duty}]} ] \
    [subst  {[format {buck_tb.RL}]} ]
group using {Output Voltage}
group set -overlay 0
group set -comment {}
group clear 0 end

group insert \
    [subst  {[format {buck_tb.VS}]} ] \
    [subst  {[format {buck_tb.EOUT}]} ] \
    [subst  {[format {buck_tb.OUT.V}]} ] \
    {MIddle node}
group using {Group 4}
group set -overlay 1
group set -comment {}
group clear 0 end

group insert \
    [subst  {[format {buck_tb.Ebuck.Swt.Iana}]} ] \
    [subst  {[format {buck_tb.Ebuck.Dio.Iana}]} ]
group using {Group 1}
group set -overlay 1
group set -comment {}
group clear 0 end

group insert \
    [subst  {[format {buck_tb.Buck.Ind.DP.Nupdt}]} ] \
    [subst  {[format {buck_tb.Buck.Ind.DP.Npts}]} ]
group using {Group 2}
group set -overlay 1
group set -comment {}
group clear 0 end

group insert \
    [subst  {[format {buck_tb.VOHee}]} ] \
    [subst  {[format {buck_tb.VOLee}]} ] \
    [subst  {[format {buck_tb.VO_AN}]} ] \
    [subst  {[format {buck_tb.VO_EE}]} ]
group using {Group 3}
group set -overlay 1
group set -comment {}
group clear 0 end

group insert \
    [subst  {[format {buck_tb.Buck.Swt.Rdrv}]} ] \
    [subst  {[format {buck_tb.Ebuck.Swt.Rramp}]} ]
group using {Group 5}
group set -overlay 1
group set -comment {}
group clear 0 end

group insert \
    [subst  {[format {buck_tb.Buck.Swt.Rdrv}]} ] \
    [subst  {[format {buck_tb.Ebuck.Swt.Rramp}]} ]
group using {Switch Resistance}
group set -overlay 1
group set -comment {}
group clear 0 end

group insert \
    [subst  {[format {buck_tb.Ebuck.Swt.Rramp}]} ] \
    [subst  {[format {buck_tb.Buck.Swt.Rdrv}]} ]
group using Output-Voltage
group set -overlay 1
group set -comment {}
group clear 0 end

group insert \
    [subst  {[format {buck_tb.EOUT}]} ] \
    [subst  {[format {buck_tb.OUT.V}]} ]
group using Inductor-Current
group set -overlay 1
group set -comment {}
group clear 0 end

group insert \
    [subst  {[format {buck_tb.Ebuck.Ind.Iana}]} ] \
    [subst  {[format {buck_tb.Buck.Ind.Iind}]} ]
group using Midnode-Voltage
group set -overlay 1
group set -comment {}
