            eval waveform format $gpID0 $attrs
        }
        if { $childcmds != ""} {
            eval $childcmds
        }
    }
    set gpGlist0 [lrange $gpGlist0 1 end]
    set gpID0 [lindex $gpGlist0 0]
}

waveform axis range $groupId0 -for default -min 0.10000000000000001 -max 100000 -scale log
waveform axis activate $groupId0 -for default
set id [waveform add -signals [subst  {
	{[format {buck_tb.Freq}]}
	} ]]
waveform format $id -trace digital
waveform axis range $id -for default -min 0 -max 100000 -scale linear
set id [waveform add -signals [subst  {
	{[format {buck_tb.Duty}]}
	} ]]
waveform format $id -trace digital
waveform axis range $id -for default -min 0 -max 0.5 -scale linear
set id [waveform add -signals [subst  {
	{[format {buck_tb.RL}]}
	} ]]
waveform format $id -trace digital
waveform axis range $id -for default -min 10 -max 100 -scale linear
set id [waveform add -signals [subst  {
	{[format {buck_tb.CK}]}
	} ]]
set id [waveform add -signals [subst  {
	{[format {buck_tb.VO_PCTERR}]}
	} ]]
waveform format $id -trace digital
waveform axis range $id -for default -min -1.0293564383315856 -max 1.0222736323764137 -scale linear
set id [waveform add -signals [subst  {
	{[format {buck_tb.RIP_PCTERR}]}
	} ]]
waveform format $id -trace digital
waveform axis range $id -for default -min -10.794593371202421 -max 3.6304819006962363 -scale linear

waveform xview limits 0 8357.1us

