#
# Mnemonic Maps
#
mmap new  -reuse -name {Boolean as Logic} -radix %b -contents {{%c=FALSE -edgepriority 1 -shape low}
{%c=TRUE -edgepriority 1 -shape high}}
mmap new  -reuse -name {Example Map} -radix %x -contents {{%b=11???? -bgcolor orange -label REG:%x -linecolor yellow -shape bus}
{%x=1F -bgcolor red -label ERROR -linecolor white -shape EVENT}
{%x=2C -bgcolor red -label ERROR -linecolor white -shape EVENT}
{%x=* -label %x -linecolor gray -shape bus}}

#
# Design Browser windows
#
if {[catch {window new WatchList -name "Design Browser 1" -geometry 730x691+232+26}] != ""} {
    window geometry "Design Browser 1" 730x691+232+26
}
window target "Design Browser 1" on
browser using {Design Browser 1}
browser set -scope  waves::buck_tb 
browser set \
    -signalsort name
browser yview see  waves::buck_tb 
browser timecontrol set -lock 0

#
# Waveform windows
#
if {[catch {window new WaveWindow -name "Waveform 2" -geometry 1473x849+439+130}] != ""} {
    window geometry "Waveform 2" 1473x849+439+130
}
window target "Waveform 2" on
waveform using {Waveform 2}
waveform sidebar visibility partial
waveform set \
    -primarycursor TimeA \
    -signalnames path \
    -signalwidth 205 \
    -units us \
    -valuewidth 156
waveform baseline set -time 0


set groupId0 [waveform add -groups Output-Voltage]
set gpGlist0 [waveform hierarchy contents $groupId0]
set gpID0 [lindex $gpGlist0 0]
foreach {name attrs}  {
    waves::buck_tb.EOUT {-height 58 -trace analogLinear}
    waves::buck_tb.OUT.V {-height 58 -trace analogLinear}
} childcmds {
    {}
    {}
} {
    set expected [ join [waveform signals -format fullpath $gpID0] ]
    if {[string equal $name $expected] || $name == "cdivider"} {
        if {$attrs != ""} {
            eval waveform format $gpID0 $attrs
        }
        if { $childcmds != ""} {
            eval $childcmds
        }
    }
    set gpGlist0 [lrange $gpGlist0 1 end]
    set gpID0 [lindex $gpGlist0 0]
}

waveform axis range $groupId0 -for default -min -1.9895183154268138e-08 -max 3.8996134595945668 -scale linear
waveform axis range $groupId0 -for V -min 0 -max 3.8373437232275562 -scale linear
waveform axis activate $groupId0 -for default

set groupId0 [waveform add -groups Inductor-Current]
set gpGlist0 [waveform hierarchy contents $groupId0]
set gpID0 [lindex $gpGlist0 0]
foreach {name attrs}  {
    waves::buck_tb.Ebuck.Ind.Iana {-height 58 -trace analogLinear}
    waves::buck_tb.Buck.Ind.Iind {-height 58 -trace analogLinear}
} childcmds {
    {}
    {}
} {
    set expected [ join [waveform signals -format fullpath $gpID0] ]
    if {[string equal $name $expected] || $name == "cdivider"} {
        if {$attrs != ""} {
            eval waveform format $gpID0 $attrs
        }
        if { $childcmds != ""} {
            eval $childcmds
        }
    }
    set gpGlist0 [lrange $gpGlist0 1 end]
    set gpID0 [lindex $gpGlist0 0]
}

waveform axis range $groupId0 -for default -min -0.0014439241498837134 -max 0.14177456642429501 -scale linear
waveform axis activate $groupId0 -for default

set groupId0 [waveform add -groups Midnode-Voltage]
set gpGlist0 [waveform hierarchy contents $groupId0]
set gpID0 [lindex $gpGlist0 0]
foreach {name attrs}  {
    waves::buck_tb.Ebuck.M {-height 40 -trace analogLinear}
    waves::buck_tb.Buck.M.V {-height 40 -trace analogLinear}
} childcmds {
    {}
    {}
} {
    set expected [ join [waveform signals -format fullpath $gpID0] ]
    if {[string equal $name $expected] || $name == "cdivider"} {
        if {$attrs != ""} {
            eval waveform format $gpID0 $attrs
        }
        if { $childcmds != ""} {
            eval $childcmds
        }
    }
    set gpGlist0 [lrange $gpGlist0 1 end]
    set gpID0 [lindex $gpGlist0 0]
}

waveform axis range $groupId0 -for default -min -0.21417744740004327 -max 147.6444291521467 -scale linear
waveform axis range $groupId0 -for V -min -0.22013590747776399 -max 303.424105161287 -scale linear
waveform axis activate $groupId0 -for V
set id [waveform add -signals  {
	waves::buck_tb.Freq
	} ]
waveform format $id -trace digital
waveform axis range $id -for default -min 0 -max 100000 -scale linear
set id [waveform add -signals  {
	waves::buck_tb.Duty
	} ]
waveform format $id -trace digital
waveform axis range $id -for default -min 0 -max 0.5 -scale linear
set id [waveform add -signals  {
	waves::buck_tb.RL
	} ]
waveform format $id -trace digital
waveform axis range $id -for default -min 10 -max 100 -scale linear
set id [waveform add -signals  {
	waves::buck_tb.CK
	} ]
set id [waveform add -signals  {
	waves::buck_tb.VO_PCTERR
	} ]
waveform format $id -trace digital
waveform axis range $id -for default -min -1.0293564383315856 -max 1.0222736323764137 -scale linear
set id [waveform add -signals  {
	waves::buck_tb.RIP_PCTERR
	} ]
waveform format $id -trace digital
waveform axis range $id -for default -min -10.794593371202421 -max 3.6304819006962363 -scale linear

waveform xview limits 0 8357.1us

