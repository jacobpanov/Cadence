#
# PPE data
#
array set dbNames ""
set dbNames(realName1) [database require waves -search {
	./waves.shm/waves.trn
	/vols/fast_ms/ronv/FastDeluxe/SVRNM_dx/exercises/Session_16/tb/waves.shm/waves.trn
}]
#
# Groups
#
catch {group new -name {MIddle node} -overlay 1}
catch {group new -name {Inductor current} -overlay 0}
catch {group new -name {Output Voltage} -overlay 0}
catch {group new -name {Group 4} -overlay 1}
catch {group new -name {Diode current} -overlay 1}
catch {group new -name {Group 1} -overlay 1}
catch {group new -name {Group 2} -overlay 1}
catch {group new -name {Group 3} -overlay 1}
catch {group new -name {Group 5} -overlay 1}
catch {group new -name {Switch Resistance} -overlay 1}
catch {group new -name Output-Voltage -overlay 1}
catch {group new -name Inductor-Current -overlay 1}
catch {group new -name Midnode-Voltage -overlay 1}
group using {MIddle node}
group set -overlay 1
group set -comment {}
group clear 0 end

group insert \
     waves::buck_tb.Ebuck.M  \
     waves::buck_tb.Buck.M.V 
group using {Inductor current}
group set -overlay 0
group set -comment {}
group clear 0 end

group insert \
     waves::buck_tb.Ebuck.Ind.Iana  \
     waves::buck_tb.Buck.Ind.Iind  \
     waves::buck_tb.Freq  \
     waves::buck_tb.Duty  \
     waves::buck_tb.RL 
group using {Output Voltage}
group set -overlay 0
group set -comment {}
group clear 0 end

