#
# Groups
#
catch {group new -name {Group 1} -overlay 1}
catch {group new -name {Group 2} -overlay 1}
group using {Group 1}
group set -overlay 1
group set -comment {}
group clear 0 end

group insert \
    [subst  {[format {integ_filt_tb.IN}]} ] \
    [subst  {[format {integ_filt_tb.OUT}]} ] \
    [subst  {[format {integ_filt_tb.ERR}]} ]
group using {Group 2}
group set -overlay 1
group set -comment {}
group clear 0 end

group insert \
    [subst  {[format {integ_filt_tb.IN}]} ] \
    [subst  {[format {integ_filt_tb.OUT}]} ] \
    [subst  {[format {integ_filt_tb.ERR}]} ]

#
# Mnemonic Maps
#
mmap new  -reuse -name {Boolean as Logic} -radix %b -contents {{%c=FALSE -edgepriority 1 -shape low}
{%c=TRUE -edgepriority 1 -shape high}}
mmap new  -reuse -name {Example Map} -radix %x -contents {{%b=11???? -bgcolor orange -label REG:%x -linecolor yellow -shape bus}
{%x=1F -bgcolor red -label ERROR -linecolor white -shape EVENT}
{%x=2C -bgcolor red -label ERROR -linecolor white -shape EVENT}
{%x=* -label %x -linecolor gray -shape bus}}

#
# Design Browser windows
#
if {[catch {window new WatchList -name "Design Browser 1" -geometry 730x500+261+33}] != ""} {
    window geometry "Design Browser 1" 730x500+261+33
}
window target "Design Browser 1" on
browser using {Design Browser 1}
browser set -scope [subst  {[format {integ_filt_tb}]} ]
browser set \
    -signalsort name
browser yview see [subst  {[format {integ_filt_tb}]} ]
browser timecontrol set -lock 0

#
# Waveform windows
#
if {[catch {window new WaveWindow -name "Waveform 3" -geometry 1472x690+2+51}] != ""} {
    window geometry "Waveform 3" 1472x690+2+51
}
window target "Waveform 3" on
waveform using {Waveform 3}
waveform sidebar visibility partial
waveform set \
    -primarycursor TimeA \
    -signalnames path \
    -signalwidth 205 \
    -units ps \
    -valuewidth 114
waveform baseline set -time 0

set id [waveform add -signals [subst  {
	{[format {integ_filt_tb.ERR}]}
	} ]]
waveform format $id -trace analogSampleAndHold
waveform axis range $id -for default -min -1.717619470290249 -max 1.7284964237826435 -scale linear
set id [waveform add -signals [subst  {
	{[format {integ_filt_tb.IN}]}
	} ]]
waveform format $id -trace analogSampleAndHold
waveform axis range $id -for default -min 0 -max 3.0000000000000013 -scale linear
set id [waveform add -signals [subst  {
	{[format {integ_filt_tb.OUT}]}
	} ]]
waveform format $id -trace analogSampleAndHold
waveform axis range $id -for default -min 0 -max 2.7273979012327092 -scale linear
set id [waveform add -signals [subst  {
	{[format {integ_filt_tb.Ts}]}
	} ]]
waveform format $id -trace analogSampleAndHold
waveform axis range $id -for default -min 4.5 -max 5.5 -scale linear
set id [waveform add -signals [subst  {
	{[format {integ_filt_tb.VIN}]}
	} ]]
waveform format $id -trace analogSampleAndHold
waveform axis range $id -for default -min 0 -max 3.0000000000000013 -scale linear
set id [waveform add -signals [subst  {
	{[format {integ_filt_tb.VSAMP}]}
	} ]]
waveform format $id -trace analogSampleAndHold
waveform axis range $id -for default -min 0 -max 3.0000000000000013 -scale linear
set id [waveform add -signals [subst  {
	{[format {integ_filt_tb.Wc}]}
	} ]]
waveform format $id -trace analogSampleAndHold
waveform axis range $id -for default -min 0.056547 -max 0.069113000000000008 -scale linear
set id [waveform add -signals [subst  {
	{[format {integ_filt_tb.integ.IC}]}
	} ]]
waveform format $id -trace analogSampleAndHold
waveform axis range $id -for default -min -1 -max 1 -scale linear
set id [waveform add -signals [subst  {
	{[format {integ_filt_tb.integ.IN}]}
	} ]]
waveform format $id -trace analogSampleAndHold
waveform axis range $id -for default -min -1.717619470290249 -max 1.7284964237826435 -scale linear
set id [waveform add -signals [subst  {
	{[format {integ_filt_tb.integ.IN0}]}
	} ]]
waveform format $id -trace analogSampleAndHold
waveform axis range $id -for default -min -1.717619470290249 -max 1.7284964237826435 -scale linear
set id [waveform add -signals [subst  {
