#
# Design Browser windows
#
if {[catch {window new WatchList -name "Design Browser 1" -geometry 730x500+449+58}] != ""} {
    window geometry "Design Browser 1" 730x500+449+58
}
window target "Design Browser 1" on
browser using {Design Browser 1}
browser set -scope [subst  {[format {top}]} ]
browser set \
    -signalsort name
browser yview see [subst  {[format {top}]} ]
browser timecontrol set -lock 0

#
# Waveform windows
#
if {[catch {window new WaveWindow -name "Waveform 1" -geometry 1465x848+264+109}] != ""} {
    window geometry "Waveform 1" 1465x848+264+109
}
window target "Waveform 1" on
waveform using {Waveform 1}
waveform sidebar visibility partial
waveform set \
    -primarycursor TimeA \
    -signalnames path \
    -signalwidth 162 \
    -units us \
    -valuewidth 93
waveform baseline set -time 0

set id [waveform add -signals [subst  {
	{[format {top.STIM.Per}]}
	} ]]
waveform format $id -trace digital
waveform axis range $id -for default -min 62.5 -max 2000.0000000000002 -scale log
set id [waveform add -signals [subst  {
	{[format {top.CK}]}
	} ]]
set id [waveform add -signals [subst  {
	{[format {top.Rload}]}
	} ]]
waveform format $id -trace digital
waveform axis range $id -for default -min 100 -max 1000000 -scale log
set id [waveform add -signals [subst  {
	{[format {top.Rin}]}
	} ]]
waveform format $id -trace digital
waveform axis range $id -for default -min 0 -max 4 -scale linear

set groupId0 [waveform add -groups {{Output Voltages}}]
set gpGlist0 [waveform hierarchy contents $groupId0]
set gpID0 [lindex $gpGlist0 0]
foreach {name attrs} [subst  {
    {[format {top.AOUT}]} {-height 52 -trace analogLinear}
    {[format {top.POUT.V}]} {-height 52 -trace analogLinear}
    {[format {top.COUT.V}]} {-height 52 -trace analogLinear}
}] childcmds {
    {}
    {}
    {}
} {
    set expected [ join [waveform signals -format path $gpID0] ]
    if {[string equal $name $expected] || $name == "cdivider"} {
        if {$attrs != ""} {
            eval waveform format $gpID0 $attrs
        }
        if { $childcmds != ""} {
            eval $childcmds
        }
    }
    set gpGlist0 [lrange $gpGlist0 1 end]
    set gpID0 [lindex $gpGlist0 0]
}

