#
# Schematic Tracer windows
#
if {[catch {window new SchematicWindow -name "Schematic Tracer 1" -geometry 900x600+626+27}] != ""} {
    window geometry "Schematic Tracer 1" 900x600+626+27
}
window target "Schematic Tracer 1" on
schematic using "Schematic Tracer 1"
schematic sidebar visibility partial
schematic set \
    -radix default \
    -fullsignalname 0 \
    -showvalue 1 \
    -showstrength 0 \
    -showgrey 0 \
    -tracemode Single \
    -showrtl 1 \
    -showcells 1 \
    -showcellpins 0
schematic timecontrol set -lock 0
schematic restore -state {# String saved with Nlview 6.7r2  2017-11-02 bk=1.4313 VDI=40 GEI=35 GUI=TK:8.6 non-TLS,tclcompat
#  -string
# non-default properties - (restore without -noprops)
property attrcolor #40e0d0
property attrfontsize 10
property boxmaxwidth 400
property boxmingap 40
property boxminheight 40
property boxminwidth 100
property buscolor #00ff00
property createnetattrdsp 2
property fillcolor1 #000000
property fillcolor2 #000000
property gatecellname 1
property netcolor #00ff00
property objecthighlight0 #ff00aa
property objecthighlight1 #ff00aa
property objecthighlight2 #00ff00
property objecthighlight3 #ffff00
property objecthighlight9 #ffffaf
property pinattrmax 200
property selectionappearance 2
property selectioncolor #ffffaf
property sheetheight 0
property sheetwidth 0
property showhierpinname 1
property showinvisibles 1
property showmarks 1
property showpgtype 1
#
module new module {}
load symbol DAI_SOURCE_IN {} DEF port 0 input -loc -14 0 0 0 pinattrdsp @name -cr -2 -5 8i attrdsp @cell -ll -10 16 10 path 0 -6 9 -6 12 -3 12 6 0 6 0 -6 path 12 -3 9 -3 9 -6 path 2 -3 6 -3 path 2 0 10 0 path 2 3 10 3
load symbol DAI_SOURCE_OUT {} DEF port 0 output -loc 26 0 12 0 pinattrdsp @name -cl 30 -5 8i attrdsp @cell -ll -10 16 10 path 0 -6 9 -6 12 -3 12 6 0 6 0 -6 path 12 -3 9 -3 9 -6 path 2 -3 6 -3 path 2 0 10 0 path 2 3 10 3
#
module new root {} -nosplit -symlib /software/commercial/cadence/XCELIUM2209/tools/dvgui/ams/symlib/analogLib.sym
load symbol {lpf2_TB worklib(sv)} {} HIERBOX fillcolor 2
load symbol rtl_Always_0 {} GEN pin 0 input.left pin 1 input.left pin 2 output.right pin 3 output.right pin 4 input.left pin 5 input.left pin 6 input.left pin 7 output.right fillcolor 1
load symbol rtl_Always_2 {} GEN pin 0 output.right pin 1 output.right pin 2 output.right pin 3 input.left pin 4 output.right pin 5 input.left fillcolor 1
load symbol rtl_Always_3 {} GEN pin 0 input.left pin 1 input.left pin 2 output.right fillcolor 1
load symbol rtl_Initial_1 {} GEN pin 4 output.right pin 5 output.right pin 6 output.right pin 7 output.right pinBus 0 output.right 4 0 1 2 3 fillcolor 1
load symbol {lpf2 worklib(sv)} {} HIERBOX pin 0 output.right pin 1 input.left pin 6 input.left pinBus 0 input.left 4 2 3 4 5 fillcolor 2
load symbol rtl_Always_6 {} GEN pin 0 input.left pin 5 input.left pin 6 output.right pin 7 input.left pin 8 output.right pin 9 input.left pin 10 output.right pin 11 output.right pinBus 0 input.left 4 1 2 3 4 fillcolor 1
load symbol rtl_Always_8 {} GEN pin 0 input.left pin 1 output.right pin 8 input.left pin 9 input.left pin 10 output.right pin 11 input.left pin 12 input.left pin 13 input.left pin 14 output.right pin 15 output.right pin 16 input.left pinBus 0 output.right 3 2 3 4 pinBus 1 output.right 3 5 6 7 fillcolor 1
load symbol rtl_Initial_5 {} GEN pin 0 input.left pin 7 output.right pin 8 input.left pin 9 output.right pinBus 0 output.right 3 1 2 3 pinBus 1 output.right 3 4 5 6 fillcolor 1
load symbol invif0_0 {} INVIF0 pin 0 input pin 1 output fillcolor 1
load symbol rtl_Unknown_4 {} GEN pin 0 output.right pin 1 input.left pin 2 input.left fillcolor 1
load inst simulator::lpf2_TB {lpf2_TB worklib(sv)} {} -attr @color #00ffff -pg 1 -lvl 1 -y 50
load inst simulator::lpf2_TB,lpf2 {lpf2 worklib(sv)} {} -hier simulator::lpf2_TB -attr @name lpf2 -attr @color #00ffff -pinAttr 0 @name OUT=-0.910044 -pinAttr 1 @name IN=-0.888136 -pinAttr 6 @name Av=1 -pinBusAttr 0 @name {Trim[3:0]=8} -hierPinAttr 0 @name OUT -hierPinAttr 1 @name IN -hierPinAttr 6 @name Av -hierPinBusAttr 0 @name {trim[3:0]} -pg 1 -lvl 3 -y 140
load inst simulator::lpf2_TB,lpf2,Initial_0 rtl_Initial_5 {} -hier simulator::lpf2_TB,lpf2 -attr @name Initial_0 -attr @cell {} -attr @color #00ff00 -pinAttr 0 @name Avnom=1 -pinAttr 7 @name clk=1 -pinAttr 8 @name Ts=7e-09 -pinAttr 9 @name period=7e-09 -pinBusAttr 0 @name {data[0:2]=} -pinBusAttr 0 @color #ffffff -pinBusAttr 1 @name {y_data[0:2]=} -pinBusAttr 1 @color #ffffff -pg 1 -lvl 1 -y 400
load inst simulator::lpf2_TB,lpf2,NOT_0 invif0_0 {} -hier simulator::lpf2_TB,lpf2 -attr @name {} -attr @cell {} -attr @color #00ff00 -pinAttr 0 @name clk=1 -pinAttr 1 @name clk=1 -pg 1 -lvl 2 -y 360
load inst simulator::lpf2_TB,lpf2,Always_0 rtl_Always_6 {} -hier simulator::lpf2_TB,lpf2 -attr @name Always_0 -attr @cell {} -attr @color #00ff00 -pinAttr 0 @name fpole0=3e+06 -pinAttr 5 @name trimStep=250000 -pinAttr 6 @name w0=1.92423e+07 -pinAttr 7 @name fpole1=5e+06 -pinAttr 8 @name w1=3.29867e+07 -pinAttr 9 @name period=7e-09 -pinAttr 10 @name normConst=0.209982 -pinAttr 11 @name numConst=0.0311022 -pinBusAttr 0 @name {trim[3:0]=8} -pg 1 -lvl 2 -y 240
load inst simulator::lpf2_TB,lpf2,Always_1 rtl_Always_8 {} -hier simulator::lpf2_TB,lpf2 -attr @name Always_1 -attr @cell {} -attr @color #00ff00 -pinAttr 0 @name IN=-0.888136 -pinAttr 1 @name sampIn=-0.888136 -pinAttr 8 @name numConst=0.0311022 -pinAttr 9 @name normConst=0.209982 -pinAttr 10 @name num_0=-0.0232538 -pinAttr 11 @name period=7e-09 -pinAttr 12 @name w0=1.92423e+07 -pinAttr 13 @name w1=3.29867e+07 -pinAttr 14 @name denom_0=0.88679 -pinAttr 15 @name outInt=-0.910044 -pinAttr 16 @name clk=1 -pinBusAttr 0 @name {data[0:2]=} -pinBusAttr 0 @color #ffffff -pinBusAttr 1 @name {y_data[0:2]=} -pinBusAttr 1 @color #ffffff -pg 1 -lvl 3 -y 240
load inst simulator::lpf2_TB,Always_0 rtl_Always_0 {} -hier simulator::lpf2_TB -attr @name Always_0 -attr @cell {} -attr @color #00ff00 -pinAttr 0 @name Vdc=0 -pinAttr 1 @name Vpk=1 -pinAttr 2 @name Phs=0.826 -pinAttr 3 @name IN=-0.888136 -pinAttr 4 @name Ts=7 -pinAttr 5 @name Fin=100000 -pinAttr 6 @name Av=1 -pinAttr 7 @name idealH_f=0.999245 -pg 1 -lvl 2 -y 150
load inst simulator::lpf2_TB,Always_1 rtl_Always_2 {} -hier simulator::lpf2_TB -attr @name Always_1 -attr @cell {} -attr @color #00ff00 -pinAttr 0 @name vhi=0.999286 -pinAttr 1 @name vlo=-0.999286 -pinAttr 2 @name Vpk_out=0.73418 -pinAttr 3 @name OUT=-0.910044 -pinAttr 4 @name up=0 -pinAttr 5 @name Vdc=0 -pg 1 -lvl 4 -y 90
load inst simulator::lpf2_TB,Always_2 rtl_Always_3 {} -hier simulator::lpf2_TB -attr @name Always_2 -attr @cell {} -attr @color #00ff00 -pinAttr 0 @name Vpk_out=0.73418 -pinAttr 1 @name Vpk=1 -pinAttr 2 @name measGain=-2.68395 -pg 1 -lvl 5 -y 480
load inst simulator::lpf2_TB,Initial_0 rtl_Initial_1 {} -hier simulator::lpf2_TB -attr @name Initial_0 -attr @cell {} -attr @color #00ff00 -pinAttr 4 @name Av=1 -pinAttr 5 @name Fin=100000 -pinAttr 6 @name Vdc=0 -pinAttr 7 @name Vpk=1 -pinBusAttr 0 @name {Trim[3:0]=8} -pg 1 -lvl 1 -y 220
load inst simulator::lpf2_TB,lpf2,Unknown_0 rtl_Unknown_4 {} -hier simulator::lpf2_TB,lpf2 -attr @name Unknown_0 -attr @cell {} -attr @color #00ff00 -pinAttr 0 @name OUT=-0.910044 -pinAttr 1 @name outInt=-0.910044 -pinAttr 2 @name Av=1 -pg 1 -lvl 4 -y 320
load net simulator::lpf2_TB,lpf2,trimStep -attr @name trimStep -attr @color #666666.1 -pin simulator::lpf2_TB,lpf2,Always_0 5
netloc simulator::lpf2_TB,lpf2,trimStep 1 1 1 N
