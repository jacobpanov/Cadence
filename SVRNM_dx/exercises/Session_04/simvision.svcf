#
# Groups
#
catch {group new -name {Group 1} -overlay 0}
catch {group new -name {Group 2} -overlay 0}
catch {group new -name {Group 3} -overlay 1}
catch {group new -name {Group 4} -overlay 1}
group using {Group 1}
group set -overlay 0
group set -comment {}
group clear 0 end

group insert \
    [subst  {[format {lpf2_TB.Fin}]} ] \
    [subst  {[format {lpf2_TB.Trim[3:0]}]} ] \
    [subst  {[format {lpf2_TB.Vpk}]} ] \
    [subst  {[format {lpf2_TB.Av}]} ] \
    [subst  {[format {lpf2_TB.IN}]} ]
group using {Group 2}
group set -overlay 0
group set -comment {}
group clear 0 end

group insert \
    [subst  {[format {lpf2_TB.OUT}]} ] \
    [subst  {[format {lpf2_TB.Vpk_out}]} ]
group using {Group 3}
group set -overlay 1
group set -comment {}
group clear 0 end

group insert \
    [subst  {[format {lpf2_TB.lpf2.IN}]} ] \
    [subst  {[format {lpf2_TB.lpf2.OUT}]} ]
group using {Group 4}
group set -overlay 1
group set -comment {}
group clear 0 end

group insert \
    [subst  {[format {lpf2_TB.OUT}]} ] \
    [subst  {[format {lpf2_TB.Vpk_out}]} ]

#
# Mnemonic Maps
#
mmap new  -reuse -name {Boolean as Logic} -radix %b -contents {{%c=FALSE -edgepriority 1 -shape low}
{%c=TRUE -edgepriority 1 -shape high}}
mmap new  -reuse -name {Example Map} -radix %x -contents {{%b=11???? -bgcolor orange -label REG:%x -linecolor yellow -shape bus}
{%x=1F -bgcolor red -label ERROR -linecolor white -shape EVENT}
{%x=2C -bgcolor red -label ERROR -linecolor white -shape EVENT}
{%x=* -label %x -linecolor gray -shape bus}}

#
# Design Browser windows
#
if {[catch {window new WatchList -name "Design Browser 1" -geometry 730x500+261+33}] != ""} {
    window geometry "Design Browser 1" 730x500+261+33
}
window target "Design Browser 1" on
browser using {Design Browser 1}
browser set -scope [subst  {[format {lpf2_TB}]} ]
browser set \
    -signalsort name
browser yview see [subst  {[format {lpf2_TB}]} ]
browser timecontrol set -lock 0

#
# Waveform windows
#
if {[catch {window new WaveWindow -name "Waveform 1" -geometry 1776x859+0+59}] != ""} {
    window geometry "Waveform 1" 1776x859+0+59
}
window target "Waveform 1" on
waveform using {Waveform 1}
waveform sidebar visibility partial
waveform set \
    -primarycursor TimeA \
    -signalnames path \
    -signalwidth 175 \
    -units ps \
    -valuewidth 75
waveform baseline set -time 0


set groupId0 [waveform add -groups {{Group 1}}]
set gpGlist0 [waveform hierarchy contents $groupId0]
set gpID0 [lindex $gpGlist0 0]
foreach {name attrs} [subst  {
    {[format {lpf2_TB.Fin}]} {-trace analogSampleAndHold}
    {[format {lpf2_TB.Trim[3:0]}]} {-trace analogSampleAndHold}
    {[format {lpf2_TB.Vpk}]} {-trace analogSampleAndHold}
    {[format {lpf2_TB.Av}]} {-trace analogSampleAndHold}
    {[format {lpf2_TB.IN}]} {-trace analogSampleAndHold}
}] childcmds {
    {}
    {}
    {}
    {}
    {}
} {
    set expected [ join [waveform signals -format path $gpID0] ]
    if {[string equal $name $expected] || $name == "cdivider"} {
        if {$attrs != ""} {
            eval waveform format $gpID0 $attrs
        }
        if { $childcmds != ""} {
            eval $childcmds
        }
    }
    set gpGlist0 [lrange $gpGlist0 1 end]
    set gpID0 [lindex $gpGlist0 0]
}


set groupId0 [waveform add -groups {{Group 4}}]
set gpGlist0 [waveform hierarchy contents $groupId0]
set gpID0 [lindex $gpGlist0 0]
foreach {name attrs} [subst  {
    {[format {lpf2_TB.OUT}]} {-height 20 -trace analogSampleAndHold}
    {[format {lpf2_TB.Vpk_out}]} {-height 20 -trace analogSampleAndHold}
}] childcmds {
    {}
    {}
} {
    set expected [ join [waveform signals -format path $gpID0] ]
    if {[string equal $name $expected] || $name == "cdivider"} {
        if {$attrs != ""} {
            eval waveform format $gpID0 $attrs
        }
        if { $childcmds != ""} {
            eval $childcmds
        }
    }
    set gpGlist0 [lrange $gpGlist0 1 end]
    set gpID0 [lindex $gpGlist0 0]
}

waveform axis range $groupId0 -for default -min -1 -max 1 -scale linear
waveform axis activate $groupId0 -for default
set id [waveform add -signals [subst  {
	{[format {lpf2_TB.Av}]}
	} ]]
waveform format $id -trace analogSampleAndHold
waveform axis range $id -for default -min 0.20000000000000001 -max 3 -scale linear
set id [waveform add -signals [subst  {
	{[format {lpf2_TB.Fin}]}
	} ]]
waveform format $id -trace analogSampleAndHold
