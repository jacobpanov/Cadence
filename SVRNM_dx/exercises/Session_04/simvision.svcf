set id [waveform add -signals [subst  {
	{[format {lpf2_TB.OUT}]}
	} ]]
waveform format $id -trace analogSampleAndHold
waveform axis range $id -for default -min -1.1287625318755954 -max 1.4753162783737539 -scale linear
set id [waveform add -signals [subst  {
	{[format {lpf2_TB.Phs}]}
	} ]]
waveform format $id -trace analogSampleAndHold
waveform axis range $id -for default -min 0 -max 0.99986800000008125 -scale linear
set id [waveform add -signals [subst  {
	{[format {lpf2_TB.Trim[3:0]}]}
	} ]]
waveform format $id -trace analogSampleAndHold
waveform axis range $id -for default -min 0 -max 15 -scale linear
set id [waveform add -signals [subst  {
	{[format {lpf2_TB.Ts}]}
	} ]]
waveform format $id -trace analogSampleAndHold
waveform axis range $id -for default -min 6.2999999999999998 -max 7.7000000000000011 -scale linear
set id [waveform add -signals [subst  {
	{[format {lpf2_TB.Vdc}]}
	} ]]
waveform format $id -trace analogSampleAndHold
waveform axis range $id -for default -min 0 -max 1 -scale linear
set id [waveform add -signals [subst  {
	{[format {lpf2_TB.Vpk}]}
	} ]]
waveform format $id -trace analogSampleAndHold
waveform axis range $id -for default -min 0.90000000000000002 -max 1.1000000000000001 -scale linear
set id [waveform add -signals [subst  {
	{[format {lpf2_TB.Vpk_out}]}
	} ]]
waveform format $id -trace analogSampleAndHold
waveform axis range $id -for default -min 0 -max 1.1285978984017353 -scale linear
set id [waveform add -signals [subst  {
