#
# Conditions
#
set expression {(tb.u_msNeuron.net8.V - tb.u_msNeuron.net7.V)}
if {[catch {condition new -name  compInDiff -expr $expression}] != ""} {
    condition set -using compInDiff -expr $expression
}
#
# Groups
#
catch {group new -name {Group 1} -overlay 0}
catch {group new -name {Group 2} -overlay 0}
catch {group new -name {Group 3} -overlay 1}
catch {group new -name {Group 4} -overlay 0}
catch {group new -name {Group 5} -overlay 1}
catch {group new -name {Group 6} -overlay 1}
catch {group new -name {Group 7} -overlay 1}
group using {Group 1}
group set -overlay 0
group set -comment {}
group clear 0 end

group using {Group 2}
group set -overlay 0
group set -comment {}
group clear 0 end

group using {Group 3}
group set -overlay 1
group set -comment {}
group clear 0 end

group using {Group 4}
group set -overlay 0
group set -comment {}
group clear 0 end

group insert \
    [subst  {[format {unsigned(tb.weightNum)}]} ] \
    [subst  {[format {tb.inputNum}]} ]
group using {Group 5}
group set -overlay 1
group set -comment {}
group clear 0 end

group insert \
    [subst  {[format {tb.weightNum}]} ] \
    [subst  {[format {tb.inputNum}]} ]
