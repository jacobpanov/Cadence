#
# Mnemonic Maps
#
mmap new  -reuse -name {Boolean as Logic} -radix %b -contents {{%c=FALSE -edgepriority 1 -shape low}
{%c=TRUE -edgepriority 1 -shape high}}
mmap new  -reuse -name {Example Map} -radix %x -contents {{%b=11???? -bgcolor orange -label REG:%x -linecolor yellow -shape bus}
{%x=1F -bgcolor red -label ERROR -linecolor white -shape EVENT}
{%x=2C -bgcolor red -label ERROR -linecolor white -shape EVENT}
{%x=* -label %x -linecolor gray -shape bus}}

#
# Design Browser windows
#
if {[catch {window new WatchList -name "Design Browser 1" -geometry 730x802+290+70}] != ""} {
    window geometry "Design Browser 1" 730x802+290+70
}
window target "Design Browser 1" on
browser using {Design Browser 1}
browser set -scope  waves::Ramp_TB.RampAa 
browser set \
    -signalsort name
browser yview see  waves::Ramp_TB.RampAa 
browser timecontrol set -lock 0

#
# Waveform windows
#
if {[catch {window new WaveWindow -name "Waveform 2" -geometry 1285x1080+598+25}] != ""} {
    window geometry "Waveform 2" 1285x1080+598+25
}
window target "Waveform 2" on
waveform using {Waveform 2}
waveform sidebar visibility partial
waveform set \
    -primarycursor TimeA \
    -signalnames path \
    -signalwidth 151 \
    -units ps \
    -valuewidth 118
waveform baseline set -time 155,022ps

set id [waveform add -signals  {
	waves::Ramp_TB.vval
	} ]
waveform format $id -trace analogSampleAndHold
waveform axis range $id -for default -min 0 -max 3 -scale linear
set id [waveform add -signals  {
	waves::Ramp_TB.ival
	} ]
waveform format $id -trace analogSampleAndHold
waveform axis range $id -for default -min 0 -max 0.0050000000000000001 -scale linear
set id [waveform add -signals  {
	waves::Ramp_TB.rval
	} ]
waveform format $id -trace analogSampleAndHold
waveform axis range $id -for default -min 10 -max 10000 -scale log
set id [waveform add -signals  {
	waves::Ramp_TB.tr
	} ]
waveform format $id -trace analogSampleAndHold
waveform axis range $id -for default -min 0 -max 80 -scale linear

set groupId0 [waveform add -groups {{Group 20}}]
set gpGlist0 [waveform hierarchy contents $groupId0]
set gpID0 [lindex $gpGlist0 0]
foreach {name attrs}  {
    waves::Ramp_TB.Aa {-trace analogLinear}
    waves::Ramp_TB.A.V {-trace analogLinear}
    waves::Ramp_TB.As.V {-trace analogLinear}
} childcmds {
    {}
    {}
    {}
} {
    set expected [ join [waveform signals -format fullpath $gpID0] ]
    if {[string equal $name $expected] || $name == "cdivider"} {
        if {$attrs != ""} {
            eval waveform format $gpID0 $attrs
        }
        if { $childcmds != ""} {
            eval $childcmds
        }
    }
    set gpGlist0 [lrange $gpGlist0 1 end]
    set gpID0 [lindex $gpGlist0 0]
}

waveform axis range $groupId0 -for default -min 0 -max 3.5000000000010099 -scale linear
waveform axis range $groupId0 -for V -min 0.5 -max 3.1249999999999996 -scale linear
waveform axis activate $groupId0 -for default

set groupId0 [waveform add -groups {{Group 21}}]
set gpGlist0 [waveform hierarchy contents $groupId0]
set gpID0 [lindex $gpGlist0 0]
