//
// V-AMS submodule
//
//--------------------------------------------------------------------------------------
`timescale 1ns/1ps

`include "constants.vams"
`include "disciplines.vams"

module resVAMS (P, N, ires, Pint, Nint, rVal );

   parameter real Tsample = 100; //sample period in nsec

   inout P;
   inout N;
   electrical P;
   electrical N;
   output Pint;
   wreal Pint;
   output Nint;
   wreal Nint;
   output ires;  // +ive means into P pin
   wreal ires;
   input rVal;
   wreal rVal;

   real Pnow;
   real Nnow;
   real Preg;
   real Nreg;
   real iVal;
   real inow;


   analog begin
      Pnow = V(P);
      Nnow = V(N);
      inow = I(<P>);

      V(P,N) <+ I(P,N) * transition(rVal,0,1n);  // Resistance
   end

   // Sample terminal values to reflect to digital
   always #Tsample begin
      Preg = Pnow;
      Nreg = Nnow;
      iVal = inow;
   end

   assign Pint = Preg;
   assign Nint = Nreg;
   assign ires = iVal;
endmodule
