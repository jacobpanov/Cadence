#
# PPE data
#
array set dbNames ""
set dbNames(realName1) [database require waves -search {
	./waves.shm/waves.trn
	/vols/fast_ms/ronv/FastDeluxe/SVRNM_dx/examples/RampEE/waves.shm/waves.trn
}]
#
# Groups
#
catch {group new -name {Group 1} -overlay 1}
catch {group new -name {Group 2} -overlay 1}
catch {group new -name {Group 3} -overlay 1}
catch {group new -name {Group 4} -overlay 1}
catch {group new -name {Group 5} -overlay 1}
catch {group new -name {Group 6} -overlay 1}
group using {Group 1}
group set -overlay 1
group set -comment {}
group clear 0 end

group insert \
     waves::VRdrv_TB.vval  \
     waves::VRdrv_TB.N1.V  \
     waves::VRdrv_TB.N2.V  \
     waves::VRdrv_TB.N3.V 
group using {Group 2}
group set -overlay 1
group set -comment {}
group clear 0 end

group insert \
     waves::VRdrv_TB.D3.Vnew  \
     waves::VRdrv_TB.D3.Vnow 
group using {Group 3}
group set -overlay 1
group set -comment {}
group clear 0 end

group insert \
     waves::VRdrv_TB.D3.Rnew  \
     waves::VRdrv_TB.D3.Rnow 
group using {Group 4}
group set -overlay 1
group set -comment {}
group clear 0 end

group insert \
     waves::VRdrv_TB.D3.Tnew  \
     waves::VRdrv_TB.D3.Tnow 
group using {Group 5}
group set -overlay 1
group set -comment {}
group clear 0 end

group insert \
     waves::VRdrv_TB.rval  \
     waves::VRdrv_TB.D1.Drv.R  \
     waves::VRdrv_TB.D2.Drv.R  \
     waves::VRdrv_TB.D3.Rnow 
group using {Group 6}
group set -overlay 1
group set -comment {}
group clear 0 end

group insert \
     waves::VRdrv_TB.vval  \
     waves::VRdrv_TB.D1.Drv.V  \
     waves::VRdrv_TB.D2.Drv.V  \
     waves::VRdrv_TB.D3.Vnow 

#
# Mnemonic Maps
#
mmap new  -reuse -name {Boolean as Logic} -radix %b -contents {{%c=FALSE -edgepriority 1 -shape low}
{%c=TRUE -edgepriority 1 -shape high}}
mmap new  -reuse -name {Example Map} -radix %x -contents {{%b=11???? -bgcolor orange -label REG:%x -linecolor yellow -shape bus}
{%x=1F -bgcolor red -label ERROR -linecolor white -shape EVENT}
{%x=2C -bgcolor red -label ERROR -linecolor white -shape EVENT}
{%x=* -label %x -linecolor gray -shape bus}}

#
# Design Browser windows
#
if {[catch {window new WatchList -name "Design Browser 1" -geometry 730x500+261+33}] != ""} {
    window geometry "Design Browser 1" 730x500+261+33
}
window target "Design Browser 1" on
browser using {Design Browser 1}
browser set -scope  waves::VRdrv_TB 
browser set \
    -signalsort name
browser yview see  waves::VRdrv_TB 
browser timecontrol set -lock 0

#
# Waveform windows
#
if {[catch {window new WaveWindow -name "Waveform 1" -geometry 1510x803+380+74}] != ""} {
    window geometry "Waveform 1" 1510x803+380+74
}
window target "Waveform 1" on
waveform using {Waveform 1}
waveform sidebar visibility partial
waveform set \
    -primarycursor TimeA \
    -signalnames path \
    -signalwidth 154 \
    -units ns \
    -valuewidth 86
waveform baseline set -time 0

set id [waveform add -signals  {
	waves::VRdrv_TB.tr
	} ]
waveform format $id -trace digital
waveform axis range $id -for default -min -1 -max 1 -scale linear

set groupId0 [waveform add -groups {{Group 1}}]
set gpGlist0 [waveform hierarchy contents $groupId0]
set gpID0 [lindex $gpGlist0 0]
foreach {name attrs}  {
    waves::VRdrv_TB.vval {-height 58 -trace analogSampleAndHold}
    waves::VRdrv_TB.N1.V {-height 58 -trace analogLinear}
    waves::VRdrv_TB.N2.V {-height 58 -trace analogLinear}
    waves::VRdrv_TB.N3.V {-height 58 -trace analogLinear}
} childcmds {
    {}
    {}
    {}
    {}
} {
    set expected [ join [waveform signals -format fullpath $gpID0] ]
    if {[string equal $name $expected] || $name == "cdivider"} {
        if {$attrs != ""} {
            eval waveform format $gpID0 $attrs
        }
        if { $childcmds != ""} {
            eval $childcmds
        }
    }
    set gpGlist0 [lrange $gpGlist0 1 end]
    set gpID0 [lindex $gpGlist0 0]
}

waveform axis range $groupId0 -for default -min 0 -max 3 -scale linear
waveform axis activate $groupId0 -for default

set groupId0 [waveform add -groups {{Group 6}}]
set gpGlist0 [waveform hierarchy contents $groupId0]
set gpID0 [lindex $gpGlist0 0]
foreach {name attrs}  {
    waves::VRdrv_TB.vval {-trace analogSampleAndHold}
    waves::VRdrv_TB.D1.Drv.V {-trace analogLinear}
    waves::VRdrv_TB.D2.Drv.V {-trace analogLinear}
    waves::VRdrv_TB.D3.Vnow {-trace analogLinear}
} childcmds {
    {}
    {}
    {}
    {}
} {
    set expected [ join [waveform signals -format fullpath $gpID0] ]
    if {[string equal $name $expected] || $name == "cdivider"} {
        if {$attrs != ""} {
            eval waveform format $gpID0 $attrs
        }
        if { $childcmds != ""} {
            eval $childcmds
        }
    }
    set gpGlist0 [lrange $gpGlist0 1 end]
    set gpID0 [lindex $gpGlist0 0]
}

waveform axis range $groupId0 -for default -min 0 -max 3.0000000000010001 -scale linear
waveform axis activate $groupId0 -for default

set groupId0 [waveform add -groups {{Group 5}}]
set gpGlist0 [waveform hierarchy contents $groupId0]
set gpID0 [lindex $gpGlist0 0]
foreach {name attrs}  {
    waves::VRdrv_TB.rval {-trace analogSampleAndHold}
    waves::VRdrv_TB.D1.Drv.R {-trace analogLinear}
    waves::VRdrv_TB.D2.Drv.R {-trace analogLinear}
    waves::VRdrv_TB.D3.Rnow {-trace analogLinear}
} childcmds {
    {}
    {}
    {}
    {}
} {
    set expected [ join [waveform signals -format fullpath $gpID0] ]
    if {[string equal $name $expected] || $name == "cdivider"} {
        if {$attrs != ""} {
            eval waveform format $gpID0 $attrs
        }
        if { $childcmds != ""} {
            eval $childcmds
        }
    }
    set gpGlist0 [lrange $gpGlist0 1 end]
    set gpID0 [lindex $gpGlist0 0]
}

waveform axis range $groupId0 -for default -min 0 -max 2100.0001000000002 -scale linear
waveform axis activate $groupId0 -for default
set id [waveform add -signals  {
	waves::VRdrv_TB.vval
	} ]
waveform format $id -trace digital
waveform axis range $id -for default -min -1 -max 1 -scale linear
set id [waveform add -signals  {
	waves::VRdrv_TB.rval
	} ]
waveform format $id -trace digital
waveform axis range $id -for default -min -1 -max 1 -scale linear
set id [waveform add -signals  {
	waves::VRdrv_TB.il
	} ]
waveform format $id -trace analogSampleAndHold
waveform axis range $id -for default -min -1 -max 1 -scale linear

waveform xview limits 0 100ns

