#
# PPE data
#
array set dbNames ""
set dbNames(realName1) [database require waves -search {
	./waves.shm/waves.trn
	/vols/fast_ms/ronv/FastLib/model_lib/EE_models/tb/opamp/waves.shm/waves.trn
}]
#
# Groups
#
catch {group new -name Resistors -overlay 1}
catch {group new -name {Input Voltages} -overlay 1}
catch {group new -name {Net Voltages} -overlay 0}
catch {group new -name {Group 1} -overlay 1}
catch {group new -name {Group 2} -overlay 0}
catch {group new -name {Group 3} -overlay 1}
catch {group new -name {Group 4} -overlay 1}
catch {group new -name {Group 5} -overlay 1}
catch {group new -name NetVoltages -overlay 1}
group using Resistors
group set -overlay 1
group set -comment {}
group clear 0 end

group insert \
     waves::opamp_tb.RI  \
     waves::opamp_tb.RF  \
     waves::opamp_tb.RL  \
     waves::opamp_tb.RSW 
group using {Input Voltages}
group set -overlay 1
group set -comment {}
group clear 0 end

group insert \
     waves::opamp_tb.Vin  \
     waves::opamp_tb.Vref 
group using {Net Voltages}
group set -overlay 0
group set -comment {}
group clear 0 end

group using {Group 1}
group set -overlay 1
group set -comment {}
group clear 0 end

group insert \
     waves::opamp_tb.Mag  \
     waves::opamp_tb.Mnom 
group using {Group 2}
group set -overlay 0
group set -comment {}
group clear 0 end

group using {Group 3}
group set -overlay 1
group set -comment {}
group clear 0 end

group using {Group 4}
group set -overlay 1
group set -comment {}
group clear 0 end

group insert \
     waves::opamp_tb.Vhi  \
     waves::opamp_tb.OUT  \
     waves::opamp_tb.Vlo 
group using {Group 5}
group set -overlay 1
group set -comment {}
group clear 0 end

group insert \
     waves::opamp_tb.Vhi  \
     waves::opamp_tb.OUT  \
     waves::opamp_tb.Vlo 
group using NetVoltages
group set -overlay 1
group set -comment {}
group clear 0 end

group insert \
     waves::opamp_tb.P  \
     waves::opamp_tb.N  \
     waves::opamp_tb.OUT 

#
# Mnemonic Maps
#
mmap new  -reuse -name {Boolean as Logic} -radix %b -contents {{%c=FALSE -edgepriority 1 -shape low}
{%c=TRUE -edgepriority 1 -shape high}}
mmap new  -reuse -name {Example Map} -radix %x -contents {{%b=11???? -bgcolor orange -label REG:%x -linecolor yellow -shape bus}
{%x=1F -bgcolor red -label ERROR -linecolor white -shape EVENT}
{%x=2C -bgcolor red -label ERROR -linecolor white -shape EVENT}
{%x=* -label %x -linecolor gray -shape bus}}

#
# Design Browser windows
#
if {[catch {window new WatchList -name "Design Browser 1" -geometry 730x500+261+33}] != ""} {
    window geometry "Design Browser 1" 730x500+261+33
}
window target "Design Browser 1" on
browser using {Design Browser 1}
browser set -scope  waves::opamp_tb.Op 
browser set \
    -signalsort name
browser yview see  waves::opamp_tb.Op 
browser timecontrol set -lock 0

#
# Waveform windows
#
if {[catch {window new WaveWindow -name "Waveform 1" -geometry 1447x930+109+137}] != ""} {
    window geometry "Waveform 1" 1447x930+109+137
}
window target "Waveform 1" on
waveform using {Waveform 1}
waveform sidebar select designbrowser
waveform set \
    -primarycursor TimeA \
    -signalnames path \
    -signalwidth 150 \
    -units us \
    -valuewidth 91
waveform baseline set -time 68.48us


set groupId0 [waveform add -groups Resistors]
set gpGlist0 [waveform hierarchy contents $groupId0]
set gpID0 [lindex $gpGlist0 0]
foreach {name attrs}  {
    waves::opamp_tb.RI {-trace analogSampleAndHold}
    waves::opamp_tb.RF {-trace analogSampleAndHold}
    waves::opamp_tb.RL {-trace analogSampleAndHold}
    waves::opamp_tb.RSW {-trace analogSampleAndHold}
} childcmds {
    {}
    {}
    {}
    {}
} {
    set expected [ join [waveform signals -format fullpath $gpID0] ]
    if {[string equal $name $expected] || $name == "cdivider"} {
        if {$attrs != ""} {
            eval waveform format $gpID0 $attrs
        }
        if { $childcmds != ""} {
            eval $childcmds
        }
    }
    set gpGlist0 [lrange $gpGlist0 1 end]
    set gpID0 [lindex $gpGlist0 0]
}

waveform axis range $groupId0 -for default -min 1 -max 1000000000 -scale log
waveform axis activate $groupId0 -for default

set groupId0 [waveform add -groups {{Input Voltages}}]
set gpGlist0 [waveform hierarchy contents $groupId0]
set gpID0 [lindex $gpGlist0 0]
foreach {name attrs}  {
    waves::opamp_tb.Vin {-trace analogSampleAndHold}
    waves::opamp_tb.Vref {-trace analogSampleAndHold}
} childcmds {
    {}
    {}
} {
    set expected [ join [waveform signals -format fullpath $gpID0] ]
    if {[string equal $name $expected] || $name == "cdivider"} {
        if {$attrs != ""} {
            eval waveform format $gpID0 $attrs
        }
        if { $childcmds != ""} {
            eval $childcmds
        }
    }
    set gpGlist0 [lrange $gpGlist0 1 end]
    set gpID0 [lindex $gpGlist0 0]
}

waveform axis range $groupId0 -for default -min -0.90000000000000058 -max 5 -scale linear
waveform axis activate $groupId0 -for default

set groupId0 [waveform add -groups NetVoltages]
set gpGlist0 [waveform hierarchy contents $groupId0]
set gpID0 [lindex $gpGlist0 0]
foreach {name attrs}  {
    waves::opamp_tb.P {-height 42 -trace analogLinear}
    waves::opamp_tb.N {-height 42 -trace analogLinear}
    waves::opamp_tb.OUT {-height 42 -trace analogLinear}
} childcmds {
    {}
    {}
    {}
} {
    set expected [ join [waveform signals -format fullpath $gpID0] ]
    if {[string equal $name $expected] || $name == "cdivider"} {
        if {$attrs != ""} {
            eval waveform format $gpID0 $attrs
        }
        if { $childcmds != ""} {
            eval $childcmds
        }
    }
    set gpGlist0 [lrange $gpGlist0 1 end]
    set gpID0 [lindex $gpGlist0 0]
}

waveform axis range $groupId0 -for V -min -0.90775412270109934 -max 5 -scale linear
waveform axis activate $groupId0 -for V
set id [waveform add -signals  {
	waves::opamp_tb.Icl
	} ]
waveform format $id -trace analogLinear
waveform axis range $id -for default -min -0.042826302466045775 -max 0.039709652930713581 -scale linear
set id [waveform add -signals  {
	waves::opamp_tb.Op.iclip
	} ]
waveform format $id -trace analogLinear
waveform axis range $id -for default -min -0.0085363352609874477 -max 0.0089799315538963941 -scale linear

set groupId0 [waveform add -groups {{Group 1}}]
set gpGlist0 [waveform hierarchy contents $groupId0]
set gpID0 [lindex $gpGlist0 0]
foreach {name attrs}  {
    waves::opamp_tb.Mag {-trace analogSampleAndHold}
    waves::opamp_tb.Mnom {-trace analogSampleAndHold}
} childcmds {
    {}
    {}
} {
    set expected [ join [waveform signals -format fullpath $gpID0] ]
    if {[string equal $name $expected] || $name == "cdivider"} {
        if {$attrs != ""} {
            eval waveform format $gpID0 $attrs
        }
        if { $childcmds != ""} {
            eval $childcmds
        }
    }
    set gpGlist0 [lrange $gpGlist0 1 end]
    set gpID0 [lindex $gpGlist0 0]
}

waveform axis range $groupId0 -for default -min -1 -max 1 -scale linear
waveform axis activate $groupId0 -for default

set groupId0 [waveform add -groups {{Group 5}}]
set gpGlist0 [waveform hierarchy contents $groupId0]
set gpID0 [lindex $gpGlist0 0]
foreach {name attrs}  {
    waves::opamp_tb.Vhi {-trace analogSampleAndHold}
    waves::opamp_tb.OUT {-trace analogLinear}
    waves::opamp_tb.Vlo {-trace analogSampleAndHold}
} childcmds {
    {}
    {}
    {}
} {
    set expected [ join [waveform signals -format fullpath $gpID0] ]
    if {[string equal $name $expected] || $name == "cdivider"} {
        if {$attrs != ""} {
            eval waveform format $gpID0 $attrs
        }
        if { $childcmds != ""} {
            eval $childcmds
        }
    }
    set gpGlist0 [lrange $gpGlist0 1 end]
    set gpID0 [lindex $gpGlist0 0]
}

waveform axis range $groupId0 -for default -min 0 -max 3.7750853785720397 -scale linear
waveform axis range $groupId0 -for V -min -0.90775412270109934 -max 4.9987668111766661 -scale linear
waveform axis activate $groupId0 -for V
set id [waveform add -signals  {
	waves::opamp_tb.Freq
	} ]
waveform format $id -trace analogSampleAndHold
waveform axis range $id -for default -min 10 -max 124999.99999999996 -scale log
set id [waveform add -signals  {
	waves::opamp_tb.Op.N1
	} ]
waveform format $id -trace analogSampleAndHold
waveform axis range $id -for V -min -1.000093865408527 -max 5.0001100767592064 -scale linear

waveform xview limits 0 68.48us

