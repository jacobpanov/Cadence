//
// Electrical inductor model, including series resistance and initial condition
// Updated 5/26/2020 (ronv) 

`include "disciplines.vams"

module  EIndD(P,N);
inout P,N; electrical P,N;  // differential pins to inductor

parameter real l=1e-9;      // inductance
parameter real rs=0;        // series resistance
parameter real ic=1e9;      // (A) uses DC op point for IC if not specified
real Vana,Iana,Iind;        // inductor analog V & I, and discrete form of I

analog begin
// inductor with specified initial current at DC:
  if (ic<1e9) I(P,N) <+ idt((V(P,N)-I(P,N)*rs)/l,ic); // integral form with IC
// inductor shorted at DC, with optional series resistance: 
  else if (rs==0) I(P,N) <+ idt((V(P,N))/l);          // integral form, no IC
  else            V(P,N) <+ ddt(l*I(P,N))+rs*I(P,N);  // derivative form with RS
  Iana = I(P,N);                                      // measure current
end

// Move current value to discrete variable on each analog timestep:
always @(absdelta(Iana,0)) Iind = Iana;  

endmodule

