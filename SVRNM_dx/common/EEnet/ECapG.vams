// ECapG.vams - ELECTRICAL MODEL of single-ended capacitor from P to ground.

`timescale 1ns/1ps
`include "disciplines.vams"

module  ECapG(P);
inout P;
electrical P;

parameter real c=1e-9;     // capacitance
parameter real rs=0;       // series resistance
parameter real ic=1e9;     // initial voltage at time zero (or big uses DCOP)
parameter real tinc=1e-9;  // (NOT USED)
parameter real vtol=1e-4;  // (NOT USED)

real Vana,Iana,Vout,Icap;  // voltage & current for capacitor itself
real Vic = (ic<1e9)? ic:0; // make bounded version of initial condition value

analog begin
  Iana = I(P);             // measure current
  if (ic<1e9) Vana = idt(I(P)/c,Vic); // integrate to get cap voltage (with IC)
  else        Vana = idt(I(P)/c);     // or default does DC op with cap open
  V(P) <+ Vana + I(P)*rs;  // apply to pin, add series resistance term
end

// Move current value to discrete variable on each analog timestep:
always @(absdelta(Iana,0)) Icap = Iana;

endmodule
