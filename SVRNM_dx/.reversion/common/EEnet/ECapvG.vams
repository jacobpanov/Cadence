// ECapvG.vams - ELECTRICAL MODEL of single-ended capacitor from P to ground
// with cap value specified by real variable.  Model assumes a portion of the 
// capacitor is switched in or out instantaneously, so all future integration
// will use the new cap value.  Cap being switched in is assumed to already 
// be charged to proper voltage so no glitch occurs.  

`timescale 1ns/1ps
`include "disciplines.vams"

module  ECapvG(P,cval);
inout P;
electrical P;
input wreal cval;

parameter real rs=0;        // series resistance
parameter real ic=1e9;      // initial voltage at time zero (or big uses DCOP)
parameter real tinc=1e-9;   // (NOT USED)
parameter real vtol=1e-4;   // (NOT USED)
parameter real cdef=1e-15;  // default value used if cval nonpositive at T=0

real Cval;                  // capacitance value to use
real Vana,Iana,Vout,Icap;   // voltage & current for capacitor itself
real Vic = (ic<1e9)? ic:0;  // make bounded version of initial condition value

always begin                // clean up incoming capacitor value
  if (cval>0) Cval = cval;  // normally cap just follows incoming value
  else if ($realtime==0) Cval = cdef; // else ignore change (use default at T=0)
  @(cval);                  // follows all valid input changes
end

analog begin
  Iana = I(P);              // measure current
  if (ic<1e9) Vana = idt(I(P)/Cval,Vic); // integrate to get cap voltage (with IC)
  else        Vana = idt(I(P)/Cval);     // or default does DC op with cap open
  V(P) <+ Vana + I(P)*rs;   // apply to pin, add series resistance term
end

// Move current value to discrete variable on each analog timestep:
always @(absdelta(Iana,0)) Icap = Iana;

endmodule

