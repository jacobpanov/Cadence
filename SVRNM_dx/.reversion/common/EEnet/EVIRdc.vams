// This is the analog electrical equivalent to a static EEnet '{V,I,R} driver.

`include "disciplines.vams"

module EVIRdc (P);

inout P; electrical P;
parameter real v=0, i=0, r=0;        // DC parameters to drive to analog net 

analog begin
  if (r==0) V(P) <+ v;               // Default is ideal voltage source.
  else      I(P) <+ (V(P)-v)/r - i;  // Else add r and i for other formats
end
endmodule
    
