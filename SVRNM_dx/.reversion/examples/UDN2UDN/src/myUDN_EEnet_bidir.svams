// Unidirectional connect module connecting myUDN to EEnet
// Takes in information on voltage value, validity and number of drivers and
// drives it as a voltage source with series resistance on the EEnet side.
// 
// Input myUDNin, Output EEnetout
// Drive conditions (myUDNin.status):
//  Ideal drive:        EEnetout = '{myUDNin.V,0,0}
//  Combination drive:  EEnetout = '{myUDNin.V,0,rout/myUDNin.drivers}
//  Inactive drive:     EEnetout = '{0,0,`wrealZState}

`timescale 1ns/1ps

// Package imports
import myUDN_pkg::*;
import EE_pkg::*;

// Module header and port list
connectmodule myUDNT_EEnet_bidir (inout myUDN myUDNin, inout EEnet EEnetout);

  // Parameters
  parameter real rout = 200;
  
  // Internal variables
  myUDN myUDN_ext;
  EEstruct EEdrv='{0,0,`wrealZState};
  
  // Get external drivers on myUDN input
  initial begin
    $cged(myUDNin,myUDN_ext);
  end
  
  // Determine EEnet output to drive
  always begin
    case(myUDNin.status)
      IDEAL:    EEdrv = EEstruct'{myUDN_ext.V,0,0};                
      COMBO:    EEdrv = EEstruct'{myUDN_ext.V,0,rout/myUDN_ext.drivers};
      INACTIVE: EEdrv = EEstruct'{0,0,`wrealZState};
    endcase
    // Triggered on a change in any of the myUDN input fields
    @(myUDN_ext.V,myUDN_ext.status,myUDN_ext.drivers);
  end
  
  // Drive EEnet output
  assign EEnetout = EEdrv;
  
endconnectmodule

