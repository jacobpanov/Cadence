    -primarycursor TimeA \
    -signalnames path \
    -signalwidth 175 \
    -units ps \
    -valuewidth 75
waveform baseline set -time 2,819,309ps

set id [waveform add -signals [subst  {
	{[format {pga_TB.invalidGainCheck}]}
	} ]]
waveform hierarchy expand $id

set groupId0 [waveform add -groups {{invalidGainCheck contributors}}]
set gpGlist0 [waveform hierarchy contents $groupId0]
set gpID0 [lindex $gpGlist0 0]
foreach {name attrs} [subst  {
    {[format {pga_TB.OUTdiff}]} {-trace analogSampleAndHold}
    {[format {pga_TB.Vsup}]} {-trace analogSampleAndHold}
    {[format {pga_TB.PD}]} {}
    {[format {pga_TB.VCVGA[2:0]}]} {}
}] childcmds {
    {}
    {}
    {}
    {}
} {
    set expected [ join [waveform signals -format path $gpID0] ]
    if {[string equal $name $expected] || $name == "cdivider"} {
        if {$attrs != ""} {
            eval waveform format $gpID0 $attrs
        }
        if { $childcmds != ""} {
            eval $childcmds
        }
    }
    set gpGlist0 [lrange $gpGlist0 1 end]
    set gpID0 [lindex $gpGlist0 0]
}

