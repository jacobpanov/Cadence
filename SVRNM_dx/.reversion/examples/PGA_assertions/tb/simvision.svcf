#
# Groups
#
catch {group new -name {gainCheck contributors} -overlay 0}
catch {group new -name {maxGainCheck contributors} -overlay 0}
catch {group new -name {invalidGainCheck contributors} -overlay 0}
catch {group new -name {maxGainCheck contributors (1)} -overlay 0}
catch {group new -name {gainCheck contributors (1)} -overlay 0}
group using {gainCheck contributors}
group set -overlay 0
group set -comment {simulator::pga_TB.gainCheck.gainCheck contributors}
group clear 0 end

group insert \
    [subst  {[format {pga_TB.measGAIN}]} ] \
    [subst  {[format {pga_TB.targGain}]} ]
group using {maxGainCheck contributors}
group set -overlay 0
group set -comment {simulator::pga_TB.maxGainCheck contributors}
group clear 0 end

group insert \
    [subst  {[format {pga_TB.OUTdiff}]} ] \
    [subst  {[format {pga_TB.Vsup}]} ] \
    [subst  {[format {pga_TB.PD}]} ] \
    [subst  {[format {pga_TB.VCVGA[2:0]}]} ]
group using {invalidGainCheck contributors}
group set -overlay 0
group set -comment {simulator::pga_TB.invalidGainCheck contributors}
group clear 0 end

