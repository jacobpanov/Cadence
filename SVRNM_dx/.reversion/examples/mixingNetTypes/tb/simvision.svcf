# SimVision Command Script (Fri Jan 31 10:48:35 AM PST 2020)
#
# Version 19.09.s008
#
# You can restore this configuration with:
#
#     simvision -input simvision.svcf
#


#
# Preferences
#
preferences set toolbar-Standard-WatchWindow {
  usual
  shown 0
}
preferences set waveform-print-variables selected
preferences set txe-locate-add-fibers 1
preferences set signal-type-colors {assertion #FF0000 output #FFA500 group #0099FF inout #00FFFF input #FFFF00 fiber #00EEEE errorsignal #FF0000 unknown #FFFFFF overlay #0099FF internal #00FF00 reference #FFFFFF}
preferences set txe-view-hold 0
preferences set txe-navigate-search-locate 0
preferences set expand-attributes trans_id
preferences set plugin-enable-svdatabrowser-new 1
preferences set cursorctl-dont-show-sync-warning 1
preferences set toolbar-Windows-WatchWindow {
  usual
  shown 0
}
preferences set verilog-colors {Su #ff0099 0 {} 1 {} HiZ #ff9900 We #00ffff Pu #9900ff Sm #00ff99 X #ff0000 StrX #ff0000 other #ffff00 Z #ff9900 Me #0000ff La #ff00ff St {}}
preferences set toolbar-sendToIndago-WaveWindow {
  usual
  position -pos 1
}
preferences set txe-navigate-waveform-locate 1
preferences set txe-view-hidden 0
preferences set toolbar-Standard-Console {
  usual
  position -pos 1
}
preferences set show-trace-highlights 1
preferences set txe-search-show-linenumbers 1
preferences set toolbar-Search-Console {
  usual
  position -pos 2
}
preferences set plugin-enable-groupscope 0
preferences set standard-methodology-filtering 1
preferences set sb-display-values 1
preferences set plugin-enable-interleaveandcompare 0
preferences set plugin-enable-waveformfrequencyplot 0
preferences set toolbar-Windows-PsnWindow {
  usual
  position -pos 2
}
preferences set toolbar-SimControl-WatchWindow {
  usual
  shown 0
}
preferences set waveform-print-colors {Color on white}
preferences set txe-navigate-waveform-next-child 1
preferences set signal-trace-sidebar-mode full
preferences set vhdl-colors {X #ff0000 0 {} L #00ffff H #00ffff U #9900ff 1 {} - {} Z #ff9900 W #ff0000}
preferences set txe-locate-scroll-x 1
preferences set txe-locate-scroll-y 1
preferences set txe-locate-pop-waveform 1
preferences set signal-trace-move-cursor 0
preferences set toolbar-TimeSearch-WatchWindow {
  usual
  shown 0
}
#
# Groups
#
catch {group new -name {Group 1} -overlay 1}
catch {group new -name {Group 2} -overlay 1}
catch {group new -name {Group 3} -overlay 1}
group using {Group 1}
group set -overlay 1
group set -comment {}
group clear 0 end

group insert \
    [subst  {[format {amsTB.u_resDemo.resVAMS.\1_$flow }]} ] \
    [subst  {[format {amsTB.resMeas.Ival}]} ]
group using {Group 2}
group set -overlay 1
group set -comment {}
group clear 0 end

group insert \
    [subst  {[format {amsTB.resMeas.Rval}]} ] \
    [subst  {[format {amsTB.u_resDemo.resVAMS.rVal}]} ]
group using {Group 3}
group set -overlay 1
group set -comment {}
group clear 0 end

group insert \
    [subst  {[format {amsTB.resMeas.Vval}]} ] \
    [subst  {[format {amsTB.VIN}]} ]

#
# Mnemonic Maps
#
mmap new  -reuse -name {Boolean as Logic} -radix %b -contents {{%c=FALSE -edgepriority 1 -shape low}
{%c=TRUE -edgepriority 1 -shape high}}
mmap new  -reuse -name {Example Map} -radix %x -contents {{%b=11???? -bgcolor orange -label REG:%x -linecolor yellow -shape bus}
{%x=1F -bgcolor red -label ERROR -linecolor white -shape EVENT}
{%x=2C -bgcolor red -label ERROR -linecolor white -shape EVENT}
{%x=* -label %x -linecolor gray -shape bus}}

#
# Design Browser windows
#
if {[catch {window new WatchList -name "Design Browser 1" -geometry 730x500+261+33}] != ""} {
    window geometry "Design Browser 1" 730x500+261+33
}
window target "Design Browser 1" on
browser using {Design Browser 1}
browser set -scope [subst  {[format {amsTB.u_resDemo.resVAMS}]} ]
browser set \
    -signalsort name
browser yview see [subst  {[format {amsTB.u_resDemo.resVAMS}]} ]
browser timecontrol set -lock 0

#
# Waveform windows
#
if {[catch {window new WaveWindow -name "Waveform 1" -geometry 1461x812+0+51}] != ""} {
    window geometry "Waveform 1" 1461x812+0+51
}
window target "Waveform 1" on
waveform using {Waveform 1}
waveform sidebar visibility partial
waveform set \
    -primarycursor TimeA \
    -signalnames path \
    -signalwidth 175 \
    -units us \
    -valuewidth 124
waveform baseline set -time 0

set id [waveform add -signals [subst  {
	{[format {amsTB.VIN}]}
	} ]]
waveform format $id -trace analogSampleAndHold
waveform axis range $id -for V -min -1 -max 1 -scale linear
set id [waveform add -signals [subst  {
	{[format {amsTB.VOUT}]}
	} ]]
waveform hierarchy expand $id
set id2 [lindex [waveform hierarchy content $id] 0]
waveform format $id2 -trace analogLinear
set id2 [lindex [waveform hierarchy content $id] 1]
waveform format $id2 -trace analogLinear
set id2 [lindex [waveform hierarchy content $id] 2]
waveform format $id2 -trace analogLinear

set groupId0 [waveform add -groups {{Group 1}}]
set gpGlist0 [waveform hierarchy contents $groupId0]
set gpID0 [lindex $gpGlist0 0]
foreach {name attrs} [subst  {
    {[format {amsTB.u_resDemo.resVAMS.\1_$flow }]} {-height 72 -trace analogLinear}
    {[format {amsTB.resMeas.Ival}]} {-height 72 -trace analogSampleAndHold}
}] childcmds {
    {}
    {}
} {
    set expected [ join [waveform signals -format path $gpID0] ]
    if {[string equal $name $expected] || $name == "cdivider"} {
        if {$attrs != ""} {
            eval waveform format $gpID0 $attrs
        }
        if { $childcmds != ""} {
            eval $childcmds
        }
    }
    set gpGlist0 [lrange $gpGlist0 1 end]
    set gpID0 [lindex $gpGlist0 0]
}

waveform axis range $groupId0 -for A -min -0.01 -max 0.01 -scale linear
waveform axis range $groupId0 -for default -min -0.01 -max 0.01 -scale linear
waveform axis activate $groupId0 -for default

set groupId0 [waveform add -groups {{Group 2}}]
set gpGlist0 [waveform hierarchy contents $groupId0]
set gpID0 [lindex $gpGlist0 0]
foreach {name attrs} [subst  {
    {[format {amsTB.resMeas.Rval}]} {-height 42 -trace analogSampleAndHold}
    {[format {amsTB.u_resDemo.resVAMS.rVal}]} {-height 42 -trace analogSampleAndHold}
}] childcmds {
    {}
    {}
} {
    set expected [ join [waveform signals -format path $gpID0] ]
    if {[string equal $name $expected] || $name == "cdivider"} {
        if {$attrs != ""} {
            eval waveform format $gpID0 $attrs
        }
        if { $childcmds != ""} {
            eval $childcmds
        }
    }
    set gpGlist0 [lrange $gpGlist0 1 end]
    set gpID0 [lindex $gpGlist0 0]
}

waveform axis range $groupId0 -for default -min 100 -max 2000 -scale linear
waveform axis activate $groupId0 -for default

set groupId0 [waveform add -groups {{Group 3}}]
set gpGlist0 [waveform hierarchy contents $groupId0]
set gpID0 [lindex $gpGlist0 0]
foreach {name attrs} [subst  {
    {[format {amsTB.resMeas.Vval}]} {-height 58 -trace analogSampleAndHold}
    {[format {amsTB.VIN}]} {-height 58 -trace analogSampleAndHold}
}] childcmds {
    {}
    {}
} {
    set expected [ join [waveform signals -format path $gpID0] ]
    if {[string equal $name $expected] || $name == "cdivider"} {
        if {$attrs != ""} {
            eval waveform format $gpID0 $attrs
        }
        if { $childcmds != ""} {
            eval $childcmds
        }
    }
    set gpGlist0 [lrange $gpGlist0 1 end]
    set gpID0 [lindex $gpGlist0 0]
}

waveform axis range $groupId0 -for default -min -1 -max 1 -scale linear
waveform axis range $groupId0 -for V -min -1 -max 1 -scale linear
waveform axis activate $groupId0 -for V

waveform xview limits 0 20us

#
# Waveform Window Links
#

#
# Console windows
#
console set -windowname Console
window geometry Console 730x250+261+564

#
# Layout selection
#
