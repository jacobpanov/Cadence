preferences set txe-locate-scroll-y 1
preferences set waveform-assertion-debug 1
preferences set txe-locate-pop-waveform 1
preferences set whats-new-dont-show-at-startup 1
preferences set toolbar-TimeSearch-WatchWindow {
  usual
  shown 0
}
preferences set toolbar-CursorControl-WaveWindow {
  usual
  position -pos 2
}
preferences set vhdl-colors {X #ff0000 0 {} L #00ffff H #00ffff U #9900ff 1 {} - {} Z #ff9900 W #ff0000}
preferences set toolbar-NavSignalList-WaveWindow {
  usual
  position -row 0
}
preferences set toolbar-Standard-WaveWindow {
  usual
  position -pos 5
}

#
# PPE data
#
array set dbNames ""
set dbNames(realName1) [database require waves -search {
	./waves.shm/waves.trn
	/vols/fast_ms/ronv/FastDeluxe/SVRNM_dx/exercises/Session_09/tb/waves.shm/waves.trn
}]
#
# Groups
#
catch {group new -name {Group 1} -overlay 1}
catch {group new -name {Group 2} -overlay 1}
catch {group new -name {Group 3} -overlay 1}
group using {Group 1}
group set -overlay 1
group set -comment {}
group clear 0 end

group insert \
     waves::RLC_tb.VR.Pval.V  \
     waves::RLC_tb.B.V  \
     waves::RLC_tb.Be 
group using {Group 2}
group set -overlay 1
group set -comment {}
group clear 0 end

group insert \
     waves::RLC_tb.L1.Iind 
group using {Group 3}
group set -overlay 1
group set -comment {}
group clear 0 end

group insert \
     waves::RLC_tb.VR.Imeas  \
     waves::RLC_tb.VRe.Imeas 

#
# Mnemonic Maps
#
mmap new  -reuse -name {Boolean as Logic} -radix %b -contents {{%c=FALSE -edgepriority 1 -shape low}
{%c=TRUE -edgepriority 1 -shape high}}
mmap new  -reuse -name {Example Map} -radix %x -contents {{%b=11???? -bgcolor orange -label REG:%x -linecolor yellow -shape bus}
{%x=1F -bgcolor red -label ERROR -linecolor white -shape EVENT}
{%x=2C -bgcolor red -label ERROR -linecolor white -shape EVENT}
{%x=* -label %x -linecolor gray -shape bus}}

#
# Design Browser windows
#
if {[catch {window new WatchList -name "Design Browser 1" -geometry 730x500+261+33}] != ""} {
    window geometry "Design Browser 1" 730x500+261+33
}
window target "Design Browser 1" on
browser using {Design Browser 1}
browser set -scope  waves::RLC_tb.VRe 
browser set \
    -signalsort name
browser yview see  waves::RLC_tb.VRe 
browser timecontrol set -lock 0

#
# Waveform windows
#
if {[catch {window new WaveWindow -name "Waveform 1" -geometry 1434x788+432+69}] != ""} {
    window geometry "Waveform 1" 1434x788+432+69
}
window target "Waveform 1" on
waveform using {Waveform 1}
waveform sidebar visibility partial
waveform set \
    -primarycursor TimeA \
    -signalnames path \
    -signalwidth 175 \
    -units ns \
    -valuewidth 89
waveform baseline set -time 0

set id [waveform add -signals  {
	waves::RLC_tb.Rs
	} ]
waveform format $id -height 70 -trace analogSampleAndHold
waveform axis range $id -for default -min 10 -max 3000.0000000000014 -scale log

set groupId0 [waveform add -groups {{Group 1}}]
set gpGlist0 [waveform hierarchy contents $groupId0]
set gpID0 [lindex $gpGlist0 0]
foreach {name attrs}  {
    waves::RLC_tb.VR.Pval.V {-height 98 -trace analogLinear}
    waves::RLC_tb.B.V {-height 98 -trace analogLinear}
    waves::RLC_tb.Be {-height 98 -trace analogLinear}
} childcmds {
    {}
    {}
    {}
} {
    set expected [ join [waveform signals -format fullpath $gpID0] ]
    if {[string equal $name $expected] || $name == "cdivider"} {
        if {$attrs != ""} {
            eval waveform format $gpID0 $attrs
        }
        if { $childcmds != ""} {
            eval $childcmds
        }
    }
    set gpGlist0 [lrange $gpGlist0 1 end]
    set gpID0 [lindex $gpGlist0 0]
}

waveform axis range $groupId0 -for default -min -1.9808775326365462 -max 3.4501250595500568 -scale linear
waveform axis range $groupId0 -for V -min -1.9888846605423414 -max 3.4506191570130205 -scale linear
waveform axis activate $groupId0 -for default

set groupId0 [waveform add -groups {{Group 3}}]
set gpGlist0 [waveform hierarchy contents $groupId0]
set gpID0 [lindex $gpGlist0 0]
foreach {name attrs}  {
    waves::RLC_tb.VR.Imeas {-height 50 -trace analogSampleAndHold}
    waves::RLC_tb.VRe.Imeas {-height 50 -trace analogSampleAndHold}
} childcmds {
    {}
    {}
} {
    set expected [ join [waveform signals -format fullpath $gpID0] ]
    if {[string equal $name $expected] || $name == "cdivider"} {
        if {$attrs != ""} {
            eval waveform format $gpID0 $attrs
        }
        if { $childcmds != ""} {
            eval $childcmds
        }
    }
    set gpGlist0 [lrange $gpGlist0 1 end]
    set gpID0 [lindex $gpGlist0 0]
}

waveform axis range $groupId0 -for default -min -0.0019735751425186991 -max 0.0020042779810130655 -scale linear
waveform axis activate $groupId0 -for default

waveform xview limits 0 1000ns

#
# Waveform Window Links
#

#
# Console windows
#
console set -windowname Console
window geometry Console 730x250+261+564

