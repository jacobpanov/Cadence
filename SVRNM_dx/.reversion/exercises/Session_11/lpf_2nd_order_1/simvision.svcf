# SimVision Command Script (Sat Jan 18 05:13:57 PM EST 2020)
#
# Version 19.12.a001
#
# You can restore this configuration with:
#
#     simvision -input /home/mitra/fixP/circuitExamples/simvision.svcf
#  or simvision -input /home/mitra/fixP/circuitExamples/simvision.svcf database1 database2 ...
#


#
# Preferences
#
preferences set toolbar-txe_waveform_navigate-WaveWindow {
  usual
  shown 1
}
preferences set toolbar-UserTB0-WatchList {
  usual
  add Vdd
  add dutu3Vdd
  shown 1
  position -row 4 -pos 1 -anchor w
  name {User Toolbar}
}
preferences set plugin-enable-svdatabrowser-new 1
preferences set user-toolbar-list {WatchList UserTB0}
preferences set toolbar-Standard-Console {
  usual
  position -pos 1
}
preferences set toolbar-Search-Console {
  usual
  position -pos 2
}
preferences set toolbar-Standard-WaveWindow {
  usual
  position -pos 1
}
preferences set plugin-enable-groupscope 0
preferences set toolbar-txe_waveform_view-WaveWindow {
  usual
  shown 1
}
preferences set sb-display-values 1
preferences set plugin-enable-interleaveandcompare 0
preferences set plugin-enable-waveformfrequencyplot 0
preferences set toolbars-style both

#
# Databases
#
array set dbNames ""
set dbNames(realName1) [ database require waves -hints {
	file ./waves.shm/waves.trn
	file /home/mitra/fixP/circuitExamples/waves.shm/waves.trn
}]
if {$dbNames(realName1) == ""} {
    set dbNames(realName1) waves
}
set dbNames(realName2) [ database require waves_overDamped -hints {
	file ./waves_overDamped.shm/waves.trn
	file /home/mitra/fixP/circuitExamples/waves_overDamped.shm/waves.trn
}]
if {$dbNames(realName2) == ""} {
    set dbNames(realName2) waves_overDamped
}
set dbNames(realName3) [ database require waves_criticallyDamped -hints {
	file ./waves_criticallyDamped.shm/waves.trn
	file /home/mitra/fixP/circuitExamples/waves_criticallyDamped.shm/waves.trn
}]
if {$dbNames(realName3) == ""} {
    set dbNames(realName3) waves_criticallyDamped
}
#
# Groups
#
catch {group new -name {Group 1} -overlay 0}
catch {group new -name {Step Response of LCR LP} -overlay 1}
group using {Group 1}
group set -overlay 0
group set -comment {}
group clear 0 end

group using {Step Response of LCR LP}
group set -overlay 1
group set -comment {}
group clear 0 end

group insert \
    [subst  {$dbNames(realName1)::[format {tb.lcrLp.Vout}]} ] \
    [subst  {$dbNames(realName2)::[format {tb.lcrLp.Vout}]} ] \
    [subst  {$dbNames(realName3)::[format {tb.lcrLp.Vout}]} ]

#
# Mnemonic Maps
#
mmap new  -reuse -name {Boolean as Logic} -radix %b -contents {{%c=FALSE -edgepriority 1 -shape low}
{%c=TRUE -edgepriority 1 -shape high}}
mmap new  -reuse -name {Example Map} -radix %x -contents {{%b=11???? -bgcolor orange -label REG:%x -linecolor yellow -shape bus}
{%x=1F -bgcolor red -label ERROR -linecolor white -shape EVENT}
{%x=2C -bgcolor red -label ERROR -linecolor white -shape EVENT}
{%x=* -label %x -linecolor gray -shape bus}}

#
# Waveform windows
#
if {[catch {window new WaveWindow -name "Waveform 1" -geometry 1259x781+821+163}] != ""} {
    window geometry "Waveform 1" 1259x781+821+163
}
window target "Waveform 1" on
waveform using {Waveform 1}
waveform sidebar select designbrowser
waveform set \
    -primarycursor TimeA \
    -signalnames path \
    -signalwidth 175 \
    -units ns \
    -valuewidth 75
waveform baseline set -time 0


set groupId0 [waveform add -groups {{Step Response of LCR LP}}]
set gpGlist0 [waveform hierarchy contents $groupId0]
set gpID0 [lindex $gpGlist0 0]
foreach {name attrs} [subst  {
    {$dbNames(realName1)::[format {tb.lcrLp.Vout}]} {-height 118 -trace analogSampleAndHold}
    {$dbNames(realName2)::[format {tb.lcrLp.Vout}]} {-height 90 -trace analogSampleAndHold}
    {$dbNames(realName3)::[format {tb.lcrLp.Vout}]} {-height 118 -trace analogSampleAndHold}
}] childcmds {
    {}
    {}
    {}
} {
    set expected [ join [waveform signals -format fullpath $gpID0] ]
    if {[string equal $name $expected] || $name == "cdivider"} {
        if {$attrs != ""} {
            eval waveform format $gpID0 $attrs
        }
        if { $childcmds != ""} {
            eval $childcmds
        }
    }
    set gpGlist0 [lrange $gpGlist0 1 end]
    set gpID0 [lindex $gpGlist0 0]
}

waveform axis range $groupId0 -for default -min 0 -max 1.8558129483317143 -scale linear
waveform axis activate $groupId0 -for default
set id [waveform add -signals [subst  {
	{$dbNames(realName3)::[format {tb.lcrLp.Vin}]}
	} ]]
waveform format $id -trace analogSampleAndHold
waveform axis range $id -for default -min 0 -max 1 -scale linear

waveform xview limits 23161.218ns 152544.577ns

#
# Waveform Window Links
#

